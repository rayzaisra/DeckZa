@implements IDisposable
@inject ISnackbar Snackbar
@inject LanguageService L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText>@Message</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_note"
                                  Label="@L["Note"]"
                                  Placeholder="@Placeholder"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Immediate="true" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(_ => MudDialog.Cancel())">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="@ConfirmColor" Class="@("ryz-busy-button" + (_saving ? " is-busy" : string.Empty))" Disabled="@_saving" OnClick="@(_ => ConfirmAsync())">
            @(_saving ? L["Saving"] : ConfirmText)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Confirm";

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    [Parameter]
    public Color ConfirmColor { get; set; } = Color.Primary;

    private MudForm? _form;
    private string? _note;
    private bool _saving;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private Task ConfirmAsync()
    {
        _saving = true;
        MudDialog.Close(DialogResult.Ok(_note?.Trim()));
        return Task.CompletedTask;
    }

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
