@page "/dashboard/task-management"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject CurrentUserAccessService Access
@inject TaskApiService TaskApi
@inject PlanApiService PlanApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject MotionService Motion
@inject TabStateService TabService
@inject LanguageService L
@using DeckZa.Application.DTOs.Plans

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">@L["Workspace"]</div>
        <h1>@L["TaskBoard"]</h1>
        <p>@L["TaskBoardSubtitle"]</p>
        @if (_plan?.MaxActiveTasks is int maxTasks)
        {
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Outlined"
                     Color="@(_plan.ActiveTaskCount >= maxTasks ? Color.Warning : Color.Default)"
                     Class="mt-2">
                @L.Format("TaskCounter", _plan.ActiveTaskCount ?? 0, maxTasks)
            </MudChip>
        }
    </div>
    <div class="d-flex gap-2 align-center">
        @if (_planResolved)
        {
            @if (AllowsImport && Access.Can(PermissionAction.Export))
            {
                <span class="ryz-reveal">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="@(_ => DownloadTemplateAsync())">
                        @L["ImportTemplate"]
                    </MudButton>
                </span>
            }
            @if (AllowsImport && Access.Can(PermissionAction.Import))
            {
                <span class="ryz-reveal">
                    <MudFileUpload T="IBrowserFile"
                                   Accept=".xlsx"
                                   Disabled="@_importing"
                                   Class="import-excel-upload"
                                   OnFilesChanged="ImportExcelAsync">
                        <CustomContent Context="upload">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.UploadFile"
                                       Class="@("ryz-busy-button" + (_importing ? " is-busy" : string.Empty))"
                                       Disabled="@_importing"
                                       OnClick="@(_ => upload.OpenFilePickerAsync())">
                                @(_importing ? L["Importing"] : L["UploadExcel"])
                            </MudButton>
                        </CustomContent>
                    </MudFileUpload>
                </span>
            }
            @if (Access.Can(PermissionAction.AddEdit))
            {
                <span class="ryz-reveal">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@IsTaskLimitReached"
                               OnClick="@(_ => OpenCreateAsync(null))">
                        @L["NewTask"]
                    </MudButton>
                </span>
            }
        }
    </div>
</div>

<MudPaper Elevation="0" Class="dashboard-card kanban-toolbar">
    <div class="kanban-toolbar-row">
        <MudSelect T="string"
                   @bind-Value="_filterApplicationId"
                   @bind-Value:after="ReloadBoardAsync"
                   Label="@L["Application"]"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="kanban-filter">
            <MudSelectItem Value="@string.Empty">@L["AllApplications"]</MudSelectItem>
            @foreach (var item in _applications)
            {
                <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   @bind-Value="_filterTaskTypeId"
                   @bind-Value:after="ReloadBoardAsync"
                   Label="@L["TaskType"]"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="kanban-filter">
            <MudSelectItem Value="@string.Empty">@L["AllTypes"]</MudSelectItem>
            @foreach (var item in _taskTypes)
            {
                <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   @bind-Value="_filterTaskPriorityId"
                   @bind-Value:after="ReloadBoardAsync"
                   Label="@L["Priority"]"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="kanban-filter">
            <MudSelectItem Value="@string.Empty">@L["AllPriorities"]</MudSelectItem>
            @foreach (var item in _taskPriorities)
            {
                <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
            }
        </MudSelect>

        <MudSpacer />

        <MudTextField @bind-Value="_searchTerm"
                       @bind-Value:after="ReloadBoardAsync"
                       Label="@L["Search"]"
                       Placeholder="@L["TitleOrDescription"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.Search"
                       Clearable="true"
                       Class="kanban-search" />
    </div>
</MudPaper>

@if (_applications.Count == 0 && !_boardLoading && _loadError is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        @L["MissingMasterDataHint"]
        <MudLink Href="#" OnClick="@(_ => OpenTaskParameter())">@L["TaskParameterKicker"]</MudLink>.
    </MudAlert>
}

@if (_boardLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}

@if (_loadError != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_loadError</MudAlert>
}

@if (_columns.Count == 0 && !_boardLoading)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        @L["NoStatusConfigured"]
    </MudAlert>
}
else if (_columns.Count == 0 && _boardLoading)
{
    <div class="kanban-board" aria-hidden="true">
        @for (var skeleton = 0; skeleton < 4; skeleton++)
        {
            <section class="kanban-column">
                <header class="kanban-column-header">
                    <span class="kanban-dot"></span>
                    <span class="ryz-skeleton-line" style="width:70px;margin:0;"></span>
                </header>
                <div class="kanban-column-body">
                    @for (var card = 0; card < 3; card++)
                    {
                        <article class="kanban-card">
                            <div class="ryz-skeleton-line" style="width:78%;"></div>
                            <div class="ryz-skeleton-line is-short" style="width:46%;"></div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}
else
{
    <div class="kanban-board">
        @foreach (var column in _columns)
        {
            <section class="kanban-column @column.ToneClass @(_dragOverStatusId == column.StatusId ? "is-dragover" : string.Empty) @(_dropFlashStatusId == column.StatusId ? "is-drop-flash" : string.Empty)"
                     @ondragover:preventDefault
                     @ondragenter="@(_ => OnDragEnter(column))"
                     @ondragleave="@(_ => OnDragLeave(column))"
                     @ondrop:preventDefault
                     @ondrop="@(_ => OnDropAsync(column))">
                <header class="kanban-column-header">
                    <span class="kanban-dot" aria-hidden="true"></span>
                    <span class="kanban-column-name">@column.Name</span>
                    <span class="kanban-count">@column.Tasks.Count</span>
                </header>

                <div class="kanban-column-body">
                    @foreach (var task in column.Tasks)
                    {
                        <article class="kanban-card @(_draggingTaskId == task.Id ? "is-dragging" : string.Empty) @(_lastMovedTaskId == task.Id ? "is-just-moved" : string.Empty)"
                                 draggable="@(Access.Can(PermissionAction.Edit) ? "true" : "false")"
                                 @ondragstart="@(_ => OnDragStart(task))"
                                 @ondragend="@(_ => OnDragEnd())">
                            <div class="kanban-card-head">
                                <span class="kanban-card-title">@task.Title</span>
                                <span class="kanban-card-actions">
                                    <PermissionGate Action="PermissionAction.Edit">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       aria-label="@L["EditTaskAria"]"
                                                       OnClick="@(_ => OpenEditAsync(task))" />
                                    </PermissionGate>
                                    <PermissionGate Action="PermissionAction.Delete">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       aria-label="@L["DeleteTaskTitle"]"
                                                       OnClick="@(_ => DeleteAsync(task))" />
                                    </PermissionGate>
                                </span>
                            </div>

                            <div class="kanban-card-meta">
                                @if (!string.IsNullOrWhiteSpace(task.ApplicationName))
                                {
                                    <span class="kanban-chip">@task.ApplicationName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(task.TaskTypeName))
                                {
                                    <span class="kanban-chip">@task.TaskTypeName</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(task.TaskPriorityName))
                                {
                                    <span class="kanban-priority @GetPriorityClass(task.TaskPriorityName)">@task.TaskPriorityName</span>
                                }
                                @if (task.DueDate.HasValue)
                                {
                                    <span class="kanban-due @(task.IsOverdue ? "is-overdue" : string.Empty)">
                                        @task.DueDate.Value.ToString("dd MMM")
                                    </span>
                                }
                            </div>
                        </article>
                    }

                    <PermissionGate Action="PermissionAction.Add">
                        <button type="button"
                                class="kanban-add"
                                disabled="@IsTaskLimitReached"
                                @onclick="@(_ => OpenCreateAsync(column.StatusId))">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                            <span>@L["NewTaskLower"]</span>
                        </button>
                    </PermissionGate>
                </div>
            </section>
        }
    </div>
}

@code {
    private static bool IsCompleted(TaskListItemDto task) => task.IsCompletedStatus;

    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new BreadcrumbItem(L["Dashboard"], "/dashboard"),
        new BreadcrumbItem(L["TaskBoard"], null, disabled: true),
    };

    private List<KanbanColumn> _columns = new();
    private List<TaskListItemDto> _boardTasks = new();
    private List<DropdownItemDto> _applications = new();
    private List<DropdownItemDto> _taskTypes = new();
    private List<DropdownItemDto> _taskPriorities = new();
    private List<DropdownItemDto> _taskStatuses = new();
    private EffectivePlanDto? _plan;

    private string _filterApplicationId = string.Empty;
    private string _filterTaskTypeId = string.Empty;
    private string _filterTaskPriorityId = string.Empty;
    private string _searchTerm = string.Empty;

    private TaskListItemDto? _draggedTask;
    private Guid? _draggingTaskId;
    private Guid? _lastMovedTaskId;
    private string? _dragOverStatusId;
    private string? _dropFlashStatusId;
    private bool _boardLoading = true;
    private readonly HashSet<Guid> _pendingMoves = new();
    private bool _importing;
    private bool _uploadAnimationPending;
    private bool _planResolved;
    private bool _revealPending;
    private string? _loadError;
    private const string TaskParameterComponent = "DeckZa.Shared.Pages.AsMember.TaskParameter, DeckZa.Shared";

    private bool AllowsImport => _plan?.AllowsExcelImport == true;

    private bool IsTaskLimitReached
        => _plan?.MaxActiveTasks is int maxTasks
           && (_plan.ActiveTaskCount ?? 0) >= maxTasks;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();
        await Access.EnsureLoadedAsync();
        _ = LoadInitialAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadInitialAsync()
    {
        try
        {
            await Task.WhenAll(LoadPlanAsync(), LoadReferenceDataAsync());
            await ReloadBoardAsync();
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealPending)
        {
            _revealPending = false;
            await Motion.RevealEnterAsync();
        }

        if (_uploadAnimationPending)
        {
            _uploadAnimationPending = false;
            await Motion.StartUploadIndicatorAsync();
        }
    }

    private async Task LoadPlanAsync()
    {
        try
        {
            _plan = await PlanApi.GetMyPlanAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _planResolved = true;
            _revealPending = true;
        }
    }

    private async Task LoadReferenceDataAsync()
    {
        try
        {
            _applications = await TaskApi.GetApplicationsAsync();
            _taskTypes = await TaskApi.GetTaskTypesAsync();
            _taskPriorities = await TaskApi.GetTaskPrioritiesAsync();
            _taskStatuses = await TaskApi.GetTaskStatusesAsync();
        }
        catch (Exception exception)
        {
            _loadError = L["FailedLoadMasterData"];
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task ReloadBoardAsync()
    {
        _boardLoading = true;
        try
        {
            var request = new TaskBoardRequestDto
            {
                ApplicationId = string.IsNullOrWhiteSpace(_filterApplicationId) ? null : _filterApplicationId,
                TaskTypeId = string.IsNullOrWhiteSpace(_filterTaskTypeId) ? null : _filterTaskTypeId,
                TaskPriorityId = string.IsNullOrWhiteSpace(_filterTaskPriorityId) ? null : _filterTaskPriorityId,
                SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim(),
            };

            _boardTasks = await TaskApi.GetBoardAsync(request);
            BuildColumns();
            _loadError = null;
        }
        catch (Exception exception)
        {
            _loadError = L["FailedLoadTaskBoard"];
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _boardLoading = false;
        }
    }

    private void BuildColumns()
    {
        var columns = new Dictionary<string, KanbanColumn>(StringComparer.Ordinal);

        for (var index = 0; index < _taskStatuses.Count; index++)
        {
            var status = _taskStatuses[index];
            columns[status.Value] = new KanbanColumn
            {
                StatusId = status.Value,
                Name = status.Text,
                Order = index + 1,
            };
        }

        foreach (var task in _boardTasks)
        {
            if (!columns.TryGetValue(task.StatusId, out var column))
            {
                column = new KanbanColumn
                {
                    StatusId = task.StatusId,
                    Name = task.StatusName ?? task.StatusId,
                    Order = task.StatusOrderSeq ?? 999,
                };
                columns[task.StatusId] = column;
            }

            column.Tasks.Add(task);
        }

        _columns = columns.Values
            .OrderBy(column => column.Order)
            .ThenBy(column => column.Name)
            .ToList();
    }

    private void OnDragStart(TaskListItemDto task)
    {
        _draggedTask = task;
        _draggingTaskId = task.Id;
    }

    private void OnDragEnd()
    {
        _draggedTask = null;
        _draggingTaskId = null;
        _dragOverStatusId = null;
    }

    private void OnDragEnter(KanbanColumn column)
    {
        if (_dragOverStatusId == column.StatusId)
        {
            return;
        }

        _dragOverStatusId = column.StatusId;
    }

    private void OnDragLeave(KanbanColumn column)
    {
        if (_dragOverStatusId == column.StatusId)
        {
            _dragOverStatusId = null;
        }
    }

    private async Task OnDropAsync(KanbanColumn column)
    {
        _dragOverStatusId = null;

        if (_draggedTask == null)
        {
            return;
        }

        var task = _draggedTask;
        _draggedTask = null;
        _draggingTaskId = null;

        if (task.StatusId == column.StatusId)
        {
            return;
        }

        var sourceColumn = _columns.FirstOrDefault(item => item.Tasks.Contains(task));
        if (sourceColumn == null || !_pendingMoves.Add(task.Id))
        {
            return;
        }

        var previousStatusId = task.StatusId;
        var previousStatusName = task.StatusName;
        var previousStatusOrder = task.StatusOrderSeq;
        var previousCompletedDate = task.CompletedDate;

        sourceColumn.Tasks.Remove(task);
        task.StatusId = column.StatusId;
        task.StatusName = column.Name;
        task.StatusOrderSeq = column.Order;
        task.IsCompletedStatus = column.Tasks.FirstOrDefault()?.IsCompletedStatus ?? task.IsCompletedStatus;
        task.IsOverdue = !IsCompleted(task)
            && task.DueDate.HasValue
            && task.DueDate.Value.Date < DateTime.Today;

        if (IsCompleted(task))
        {
            task.CompletedDate = DateTime.Now;
        }

        column.Tasks.Add(task);
        SortColumn(column);

        _lastMovedTaskId = task.Id;
        _dropFlashStatusId = column.StatusId;
        StateHasChanged();

        try
        {
            var result = await TaskApi.MoveAsync(task.Id, column.StatusId);
            if (result.Success)
            {
                Snackbar.Add(L.Message(ApiMessageSource.From(result), "TaskMoved"), Severity.Success);
            }
            else
            {
                column.Tasks.Remove(task);
                sourceColumn.Tasks.Add(task);
                task.StatusId = previousStatusId;
                task.StatusName = previousStatusName;
                task.StatusOrderSeq = previousStatusOrder;
                task.CompletedDate = previousCompletedDate;
                SortColumn(sourceColumn);
                Snackbar.Add(L.Message(ApiMessageSource.From(result), "FailedMoveTask"), Severity.Error);
            }
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
            await ReloadBoardAsync();
        }
        finally
        {
            _pendingMoves.Remove(task.Id);
            _ = ClearMoveHighlightAsync();
        }
    }

    private async Task ClearMoveHighlightAsync()
    {
        await Task.Delay(450);
        _lastMovedTaskId = null;
        _dropFlashStatusId = null;
        await InvokeAsync(StateHasChanged);
    }

    private static void SortColumn(KanbanColumn column)
    {
        var ordered = column.Tasks
            .OrderByDescending(task => task.CompletedDate ?? task.DueDate ?? task.RequestDate)
            .ThenBy(task => task.Title, StringComparer.OrdinalIgnoreCase)
            .ToList();

        column.Tasks.Clear();
        column.Tasks.AddRange(ordered);
    }

    private void OpenTaskParameter()
        => TabService.OpenTab(L["Menu.TSKP-APP"], TaskParameterComponent, "/dashboard/task-parameter/application", icon: "Tune");

    private async Task DownloadTemplateAsync()
    {
        try
        {
            var url = await TaskApi.GetImportTemplateUrlAsync();
            if (string.IsNullOrWhiteSpace(url))
            {
                Snackbar.Add(L["FailedPrepareTemplate"], Severity.Error);
                return;
            }

            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task ImportExcelAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file == null)
        {
            return;
        }

        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add(L["OnlyXlsxSupported"], Severity.Warning);
            return;
        }

        if (file.Size <= 0 || file.Size > 1024 * 1024)
        {
            Snackbar.Add(L["FileBetween1ByteAnd1Mb"], Severity.Warning);
            return;
        }

        var confirmDialog = await DialogService.ShowAsync<ConfirmDialog>(
            L["ImportTaskTitle"],
            new DialogParameters
            {
                ["Title"] = L["ImportTaskTitle"],
                ["Message"] = L["ImportTaskMessage"],
                ["ConfirmText"] = L["Import"],
                ["CancelText"] = L["Cancel"],
            });

        var confirmResult = await confirmDialog.Result;
        if (confirmResult is not { Canceled: false })
        {
            return;
        }

        _importing = true;
        _uploadAnimationPending = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(1024 * 1024);
            var response = await TaskApi.ImportAsync(stream, file.Name);
            if (response == null)
            {
                Snackbar.Add(L["ImportFailedTryAgain"], Severity.Error);
                return;
            }

            if (!response.Success || response.Data == null)
            {
                Snackbar.Add(response.Message ?? L["ImportFailed"], Severity.Error);
                return;
            }

            var result = response.Data;

            await Motion.CompleteUploadIndicatorAsync();
            await Task.Delay(900);
            _importing = false;
            StateHasChanged();

            Snackbar.Add(
                L.Format("ImportCompletedSummary", result.SuccessCount, result.RejectedCount),
                result.RejectedCount > 0 ? Severity.Warning : Severity.Success);

            if (result.RejectedCount > 0)
            {
                var details = string.Join(
                    Environment.NewLine,
                    result.Rejections.Take(10).Select(item => L.Format("ImportRowError", item.RowNumber, item.Message)));

                var resultDialog = await DialogService.ShowAsync<ConfirmDialog>(
                    L["ImportResultTitle"],
                    new DialogParameters
                    {
                        ["Title"] = L["ImportResultTitle"],
                        ["Message"] = details,
                        ["ConfirmText"] = L["Ok"],
                        ["CancelText"] = L["Close"],
                    });

                await resultDialog.Result;
            }

            await ReloadBoardAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            await Motion.StopUploadIndicatorAsync();
            _uploadAnimationPending = false;
            _importing = false;
        }
    }

    private async Task OpenCreateAsync(string? statusId)
    {
        var parameters = new DialogParameters
        {
            ["IsEdit"] = false,
            ["DefaultStatusId"] = statusId ?? string.Empty,
            ["Applications"] = _applications,
            ["TaskTypes"] = _taskTypes,
            ["TaskPriorities"] = _taskPriorities,
            ["TaskStatuses"] = _taskStatuses,
        };

        var dialog = await DialogService.ShowAsync<TaskEditDialog>(
            L["NewTask"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TaskEditDto dto })
        {
            var response = await TaskApi.CreateAsync(dto);
            if (response.Success)
            {
                Snackbar.Add(L.Message(ApiMessageSource.From(response), "TaskCreated"), Severity.Success);
                await Task.WhenAll(LoadPlanAsync(), ReloadBoardAsync());
            }
            else
            {
                Snackbar.Add(L.Message(ApiMessageSource.From(response), "FailedCreateTask"), Severity.Error);
            }
        }
    }

    private async Task OpenEditAsync(TaskListItemDto task)
    {
        var detail = await TaskApi.GetAsync(task.Id);
        if (detail == null)
        {
            Snackbar.Add(L["TaskNotFound"], Severity.Error);
            await ReloadBoardAsync();
            return;
        }

        var model = new TaskEditDto
        {
            Title = detail.Title,
            Description = detail.Description,
            ApplicationId = detail.ApplicationId,
            RequestBy = detail.RequestBy,
            RequestDate = detail.RequestDate,
            DueDate = detail.DueDate,
            StatusId = detail.StatusId,
            TaskTypeId = detail.TaskTypeId,
            TaskPriorityId = detail.TaskPriorityId,
        };

        var parameters = new DialogParameters
        {
            ["IsEdit"] = true,
            ["Model"] = model,
            ["Applications"] = _applications,
            ["TaskTypes"] = _taskTypes,
            ["TaskPriorities"] = _taskPriorities,
            ["TaskStatuses"] = _taskStatuses,
        };

        var dialog = await DialogService.ShowAsync<TaskEditDialog>(
            L["EditTask"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TaskEditDto dto })
        {
            var response = await TaskApi.UpdateAsync(task.Id, dto);
            if (response.Success)
            {
                Snackbar.Add(L.Message(ApiMessageSource.From(response), "TaskUpdated"), Severity.Success);
                await ReloadBoardAsync();
            }
            else
            {
                Snackbar.Add(L.Message(ApiMessageSource.From(response), "FailedUpdateTask"), Severity.Error);
            }
        }
    }

    private async Task DeleteAsync(TaskListItemDto task)
    {
        var parameters = new DialogParameters
        {
            ["Title"] = L["DeleteTaskTitle"],
            ["Message"] = L.Format("DeleteTaskMessage", task.Title),
            ["ConfirmText"] = L["Delete"],
            ["CancelText"] = L["Cancel"],
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["DeleteTaskTitle"], parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var response = await TaskApi.DeleteAsync(task.Id);
            if (response.Success)
            {
                Snackbar.Add(L.Message(ApiMessageSource.From(response), "TaskDeleted"), Severity.Success);
                await Task.WhenAll(LoadPlanAsync(), ReloadBoardAsync());
            }
            else
            {
                Snackbar.Add(L.Message(ApiMessageSource.From(response), "FailedDeleteTask"), Severity.Error);
            }
        }
    }

    private static string GetPriorityClass(string? priorityName)
    {
        var value = (priorityName ?? string.Empty).Trim().ToLowerInvariant();
        return value switch
        {
            "low" => "is-low",
            "normal" => "is-normal",
            "high" => "is-high",
            "vip" => "is-vip",
            _ => "is-normal",
        };
    }

    private sealed class KanbanColumn
    {
        public string StatusId { get; init; } = string.Empty;
        public string Name { get; init; } = string.Empty;
        public int Order { get; init; }
        public List<TaskListItemDto> Tasks { get; } = new();
        public string ToneClass => $"kanban-tone-{(Math.Max(Order, 1) - 1) % 5 + 1}";
    }

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
