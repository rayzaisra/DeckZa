@page "/dashboard/calendar"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject TaskApiService TaskApi
@inject PlanApiService PlanApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject MotionService Motion
@inject LanguageService L
@using System.Globalization

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">@L["Workspace"]</div>
        <h1>@L["CalendarTitle"]</h1>
        <p>@L["CalendarSubtitle"]</p>
    </div>
    @if (!_calendarUnavailable)
    {
        <div class="d-flex gap-2 align-center">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Today"
                       OnClick="@(_ => GoToTodayAsync())">
                @L["Today"]
            </MudButton>
            <MudToggleGroup T="string"
                            @bind-Value="_viewMode"
                            @bind-Value:after="OnViewModeChangedAsync"
                            Size="Size.Small"
                            Color="Color.Primary">
                <MudToggleItem Value="@("month")" Text="@L["Month"]" />
                <MudToggleItem Value="@("year")" Text="@L["Year"]" />
            </MudToggleGroup>
        </div>
    }
</div>

@if (_calendarUnavailable)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        @L["CalendarUnavailable"]
    </MudAlert>
}
else
{
<MudPaper Elevation="0" Class="dashboard-card kanban-toolbar">
    <div class="kanban-toolbar-row">
        <MudSelect T="string"
                   @bind-Value="_filterApplicationId"
                   @bind-Value:after="ReloadAsync"
                   Label="@L["Application"]"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="kanban-filter">
            <MudSelectItem Value="@string.Empty">@L["AllApplications"]</MudSelectItem>
            @foreach (var item in _applications)
            {
                <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   @bind-Value="_filterTaskTypeId"
                   @bind-Value:after="ReloadAsync"
                   Label="@L["TaskType"]"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="kanban-filter">
            <MudSelectItem Value="@string.Empty">@L["AllTypes"]</MudSelectItem>
            @foreach (var item in _taskTypes)
            {
                <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   @bind-Value="_filterStatusId"
                   @bind-Value:after="ReloadAsync"
                   Label="@L["Status"]"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="kanban-filter">
            <MudSelectItem Value="@string.Empty">@L["AllStatuses"]</MudSelectItem>
            @foreach (var item in _taskStatuses)
            {
                <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
            }
        </MudSelect>
    </div>
</MudPaper>

<div class="calendar-shell">
    <div class="calendar-nav">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                       Color="Color.Primary"
                       aria-label="@(_viewMode == "month" ? L["PreviousMonth"] : L["PreviousYear"])"
                       OnClick="@(_ => NavigateAsync(-1))" />
        <div class="calendar-period">
            <div class="calendar-period-main">@PeriodLabel</div>
            <div class="calendar-period-sub">@TaskCountLabel</div>
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                       Color="Color.Primary"
                       aria-label="@(_viewMode == "month" ? L["NextMonth"] : L["NextYear"])"
                       OnClick="@(_ => NavigateAsync(1))" />
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }

    @if (_loadError != null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@_loadError</MudAlert>
    }

    @if (HasCalendarPlaceholder)
    {
        <div class="calendar-month" aria-hidden="true">
            <div class="calendar-weekdays">
                @foreach (var day in WeekdayLabels)
                {
                    <div class="calendar-weekday">@day</div>
                }
            </div>
            <div class="calendar-grid">
                @for (var cell = 0; cell < 42; cell++)
                {
                    <div class="calendar-cell">
                        <span class="ryz-skeleton-line" style="width:18px;margin:0;"></span>
                    </div>
                }
            </div>
        </div>
    }
    else if (_viewMode == "month")
    {
        <div class="calendar-month">
            <div class="calendar-weekdays">
                @foreach (var day in WeekdayLabels)
                {
                    <div class="calendar-weekday">@day</div>
                }
            </div>

            <div class="calendar-flip">
                <div class="calendar-grid">
                    @foreach (var cell in _monthCells)
                {
                    <button type="button"
                            class="calendar-cell @(cell.IsCurrentMonth ? string.Empty : "is-outside") @(cell.IsToday ? "is-today" : string.Empty) @(cell.IsSelected ? "is-selected" : string.Empty) @(cell.TaskCount > 0 ? "has-task" : string.Empty)"
                            aria-label="@L.Format("DayCellAria", cell.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), cell.TaskCount)"
                            @onclick="@(_ => SelectDateAsync(cell))">
                        <span class="calendar-day">@cell.Date.Day</span>
                        @if (cell.TaskCount > 0)
                        {
                            <span class="calendar-badge">@cell.TaskCount</span>
                        }
                        @if (cell.TaskCount > 0)
                        {
                            <span class="calendar-dots" aria-hidden="true">
                                @for (var index = 0; index < Math.Min(cell.TaskCount, 4); index++)
                                {
                                    <span class="calendar-dot"></span>
                                }
                            </span>
                        }
                    </button>
                }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="calendar-year">
            @foreach (var month in _yearMonths)
            {
                <button type="button"
                        class="calendar-mini @(month.IsCurrentMonth ? "is-current" : string.Empty) @(month.TaskCount > 0 ? "has-task" : string.Empty)"
                        @onclick="@(_ => OpenMonthAsync(month))">
                    <div class="calendar-mini-head">
                        <span class="calendar-mini-name">@month.Name</span>
                        @if (month.TaskCount > 0)
                        {
                            <span class="calendar-badge">@month.TaskCount</span>
                        }
                    </div>
                    <div class="calendar-mini-grid" aria-hidden="true">
                        @for (var day = 1; day <= month.DaysInMonth; day++)
                        {
                            <span class="calendar-mini-day @(month.TaskDays.Contains(day) ? "has-task" : string.Empty)">@day</span>
                        }
                    </div>
                </button>
            }
        </div>
    }
</div>

@if (_selectedDate.HasValue)
{
    <div class="calendar-modal-backdrop" @onclick="CloseDayPanelAsync">
        <MudPaper Elevation="0" Class="dashboard-card calendar-day-modal" @onclick:stopPropagation="true">
            <div class="calendar-day-head">
                <div>
                    <div class="dashboard-kicker">@L["TasksOn"]</div>
                    <h3>@_selectedDate.Value.ToString("dddd, dd MMMM yyyy", Culture)</h3>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               aria-label="@L["CloseDayPanel"]"
                               OnClick="@(_ => CloseDayPanelAsync())" />
            </div>

            @if (_selectedTasks.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    @L["NoTaskDueThisDate"]
                </MudAlert>
            }
            else
            {
                <div class="calendar-task-list">
                    @foreach (var task in _selectedTasks)
                    {
                        <article class="calendar-task @(task.IsOverdue ? "is-overdue" : string.Empty)">
                            <div class="calendar-task-main">
                                <div class="calendar-task-title">@task.Title</div>
                                <div class="calendar-task-meta">
                                    @if (!string.IsNullOrWhiteSpace(task.ApplicationName))
                                    {
                                        <span class="kanban-chip">@task.ApplicationName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(task.TaskTypeName))
                                    {
                                        <span class="kanban-chip">@task.TaskTypeName</span>
                                    }
                                    <span class="kanban-chip">@task.StatusName</span>
                                    @if (!string.IsNullOrWhiteSpace(task.TaskPriorityName))
                                    {
                                        <span class="kanban-priority">@task.TaskPriorityName</span>
                                    }
                                </div>
                            </div>
                            <span class="calendar-task-due">@L.Format("DueAt", task.DueDate?.ToString("HH:mm"))</span>
                            <div class="calendar-task-actions">
                                <PermissionGate Action="PermissionAction.ViewDetail">
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   aria-label="@L["TaskDetailAria"]"
                                                   OnClick="@(_ => ShowDetailAsync(task))" />
                                </PermissionGate>
                                <PermissionGate Action="PermissionAction.Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   aria-label="@L["EditTaskAria"]"
                                                   OnClick="@(_ => OpenEditAsync(task))" />
                                </PermissionGate>
                            </div>
                        </article>
                    }
                </div>
            }
        </MudPaper>
    </div>
}
}

@code {
    private string[] WeekdayLabels => new[]
    {
        L["WeekdayMon"], L["WeekdayTue"], L["WeekdayWed"], L["WeekdayThu"],
        L["WeekdayFri"], L["WeekdaySat"], L["WeekdaySun"],
    };

    private static CultureInfo Culture => CultureInfo.CurrentCulture;

    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new BreadcrumbItem(L["Dashboard"], "/dashboard"),
        new BreadcrumbItem(L["CalendarTitle"], "/dashboard/calendar", disabled: true),
    };

    private readonly Dictionary<DateTime, List<TaskListItemDto>> _tasksByDate = new();
    private readonly List<TaskListItemDto> _selectedTasks = new();

    private List<DropdownItemDto> _applications = new();
    private List<DropdownItemDto> _taskTypes = new();
    private List<DropdownItemDto> _taskPriorities = new();
    private List<DropdownItemDto> _taskStatuses = new();
    private List<MonthCell> _monthCells = new();
    private List<MonthSummary> _yearMonths = new();

    private string _viewMode = "month";
    private string _filterApplicationId = string.Empty;
    private string _filterTaskTypeId = string.Empty;
    private string _filterStatusId = string.Empty;
    private DateTime _cursor = DateTime.Today;
    private DateTime? _selectedDate;
    private bool _loading = true;
    private bool _calendarUnavailable;
    private string? _loadError;
    private int _slideDirection;

    private string PeriodLabel => _viewMode == "month"
        ? _cursor.ToString("MMMM yyyy", Culture)
        : _cursor.Year.ToString(Culture);

    private string TaskCountLabel
    {
        get
        {
            var total = _tasksByDate.Values.Sum(items => items.Count);
            return total == 1 ? L["TaskWithDueDateOne"] : L.Format("TasksWithDueDateMany", total);
        }
    }

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();
        _ = LoadInitialAsync();
    }

    private void HandleLanguageChanged()
    {
        BuildYearMonths();
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadInitialAsync()
    {
        try
        {
            try
            {
                var plan = await PlanApi.GetMyPlanAsync();
                if (plan != null && !plan.AllowsCalendar)
                {
                    _calendarUnavailable = true;
                    return;
                }
            }
            catch (Exception exception)
            {
                Snackbar.Add(exception.Message, Severity.Error);
            }

            await LoadReferenceDataAsync();
            _loading = false;
            await ReloadAsync();
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool HasCalendarPlaceholder => _loading && _monthCells.Count == 0 && _yearMonths.Count == 0;

    private async Task LoadReferenceDataAsync()
    {
        try
        {
            _applications = await TaskApi.GetApplicationsAsync();
            _taskTypes = await TaskApi.GetTaskTypesAsync();
            _taskPriorities = await TaskApi.GetTaskPrioritiesAsync();
            _taskStatuses = await TaskApi.GetTaskStatusesAsync();
        }
        catch (Exception exception)
        {
            _loadError = L["FailedLoadMasterData"];
            Snackbar.Add(exception.Message, Severity.Error);
        }
    }

    private async Task ReloadAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        try
        {
            var from = _viewMode == "month"
                ? new DateTime(_cursor.Year, _cursor.Month, 1)
                : new DateTime(_cursor.Year, 1, 1);
            var to = _viewMode == "month"
                ? from.AddMonths(1).AddDays(-1)
                : new DateTime(_cursor.Year, 12, 31);

            var tasks = await TaskApi.GetCalendarAsync(new TaskCalendarRequestDto
            {
                DateFrom = from,
                DateTo = to,
                ApplicationId = string.IsNullOrWhiteSpace(_filterApplicationId) ? null : _filterApplicationId,
                TaskTypeId = string.IsNullOrWhiteSpace(_filterTaskTypeId) ? null : _filterTaskTypeId,
                StatusId = string.IsNullOrWhiteSpace(_filterStatusId) ? null : _filterStatusId,
            });

            _tasksByDate.Clear();
            foreach (var task in tasks.Where(item => item.DueDate.HasValue))
            {
                var day = task.DueDate!.Value.Date;
                if (!_tasksByDate.TryGetValue(day, out var bucket))
                {
                    bucket = new List<TaskListItemDto>();
                    _tasksByDate[day] = bucket;
                }

                bucket.Add(task);
            }

            BuildMonthCells();
            BuildYearMonths();
            RefreshSelectedTasks();
            _loadError = null;
        }
        catch (Exception exception)
        {
            _loadError = L["FailedLoadCalendar"];
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildMonthCells()
    {
        _monthCells = new List<MonthCell>();

        var first = new DateTime(_cursor.Year, _cursor.Month, 1);
        var offset = ((int)first.DayOfWeek + 6) % 7;
        var start = first.AddDays(-offset);

        for (var index = 0; index < 42; index++)
        {
            var date = start.AddDays(index);
            _monthCells.Add(new MonthCell
            {
                Date = date,
                IsCurrentMonth = date.Month == _cursor.Month && date.Year == _cursor.Year,
                IsToday = date.Date == DateTime.Today,
                IsSelected = _selectedDate.HasValue && date.Date == _selectedDate.Value.Date,
                TaskCount = _tasksByDate.TryGetValue(date.Date, out var items) ? items.Count : 0,
            });
        }
    }

    private void BuildYearMonths()
    {
        _yearMonths = new List<MonthSummary>();

        for (var month = 1; month <= 12; month++)
        {
            var start = new DateTime(_cursor.Year, month, 1);
            var end = start.AddMonths(1);
            var taskDays = new HashSet<int>();

            foreach (var entry in _tasksByDate.Where(item => item.Key >= start && item.Key < end))
            {
                taskDays.Add(entry.Key.Day);
            }

            _yearMonths.Add(new MonthSummary
            {
                Name = start.ToString("MMM", Culture),
                Month = month,
                DaysInMonth = DateTime.DaysInMonth(_cursor.Year, month),
                IsCurrentMonth = DateTime.Today.Year == _cursor.Year && DateTime.Today.Month == month,
                TaskCount = _tasksByDate.Where(item => item.Key >= start && item.Key < end).Sum(item => item.Value.Count),
                TaskDays = taskDays,
            });
        }
    }

    private void RefreshSelectedTasks()
    {
        _selectedTasks.Clear();
        if (!_selectedDate.HasValue)
        {
            return;
        }

        if (_tasksByDate.TryGetValue(_selectedDate.Value.Date, out var items))
        {
            _selectedTasks.AddRange(items);
        }
    }

    private async Task SelectDateAsync(MonthCell cell)
    {
        _selectedDate = cell.Date;
        BuildMonthCells();
        RefreshSelectedTasks();
        await Task.CompletedTask;
    }

    private async Task CloseDayPanelAsync()
    {
        _selectedDate = null;
        BuildMonthCells();
        _selectedTasks.Clear();
        await Task.CompletedTask;
    }

    private async Task NavigateAsync(int direction)
    {
        _slideDirection = direction;
        _cursor = _viewMode == "month" ? _cursor.AddMonths(direction) : _cursor.AddYears(direction);
        await ReloadAsync();
        await PlaySlideAsync();
    }

    private async Task PlaySlideAsync()
    {
        if (_viewMode != "month" || _slideDirection == 0)
        {
            return;
        }

        await Motion.PlayCalendarSlideAsync(_slideDirection > 0);
    }

    private async Task GoToTodayAsync()
    {
        _cursor = DateTime.Today;
        _selectedDate = DateTime.Today;
        await ReloadAsync();
    }

    private async Task OnViewModeChangedAsync()
    {
        _selectedDate = null;
        _selectedTasks.Clear();
        await ReloadAsync();
    }

    private async Task OpenMonthAsync(MonthSummary month)
    {
        _viewMode = "month";
        _cursor = new DateTime(_cursor.Year, month.Month, 1);
        _selectedDate = null;
        await ReloadAsync();
    }

    private async Task ShowDetailAsync(TaskListItemDto task)
    {
        var detail = await TaskApi.GetAsync(task.Id) ?? task;

        var parameters = new DialogParameters
        {
            ["IsEdit"] = true,
            ["IsReadOnly"] = true,
            ["Model"] = new TaskEditDto
            {
                Title = detail.Title,
                Description = detail.Description,
                ApplicationId = detail.ApplicationId,
                RequestBy = detail.RequestBy,
                RequestDate = detail.RequestDate,
                DueDate = detail.DueDate,
                StatusId = detail.StatusId,
                TaskTypeId = detail.TaskTypeId,
                TaskPriorityId = detail.TaskPriorityId,
            },
            ["Applications"] = _applications,
            ["TaskTypes"] = _taskTypes,
            ["TaskPriorities"] = _taskPriorities,
            ["TaskStatuses"] = _taskStatuses,
        };

        var dialog = await DialogService.ShowAsync<TaskEditDialog>(
            L["TaskDetail"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        await dialog.Result;
    }

    private async Task OpenEditAsync(TaskListItemDto task)
    {
        var model = new TaskEditDto
        {
            Title = task.Title,
            Description = task.Description,
            ApplicationId = task.ApplicationId,
            RequestBy = task.RequestBy,
            RequestDate = task.RequestDate,
            DueDate = task.DueDate,
            StatusId = task.StatusId,
            TaskTypeId = task.TaskTypeId,
            TaskPriorityId = task.TaskPriorityId,
        };

        var parameters = new DialogParameters
        {
            ["IsEdit"] = true,
            ["Model"] = model,
            ["Applications"] = _applications,
            ["TaskTypes"] = _taskTypes,
            ["TaskPriorities"] = _taskPriorities,
            ["TaskStatuses"] = _taskStatuses,
        };

        var dialog = await DialogService.ShowAsync<TaskEditDialog>(
            L["EditTask"],
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TaskEditDto dto })
        {
            var response = await TaskApi.UpdateAsync(task.Id, dto);
            Snackbar.Add(
                L.Message(ApiMessageSource.From(response), response.Success ? "TaskUpdated" : "FailedUpdateTask"),
                response.Success ? Severity.Success : Severity.Error);

            if (response.Success)
            {
                await ReloadAsync();
            }
        }
    }

    private sealed class MonthCell
    {
        public DateTime Date { get; init; }
        public bool IsCurrentMonth { get; init; }
        public bool IsToday { get; init; }
        public bool IsSelected { get; init; }
        public int TaskCount { get; init; }
    }

    private sealed class MonthSummary
    {
        public string Name { get; init; } = string.Empty;
        public int Month { get; init; }
        public int DaysInMonth { get; init; }
        public bool IsCurrentMonth { get; init; }
        public int TaskCount { get; init; }
        public HashSet<int> TaskDays { get; init; } = new();
    }

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
