@page "/dashboard/billing"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject PlanApiService PlanApi
@inject PaymentApiService PaymentApi
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">Workspace</div>
        <h1>Billing</h1>
        <p>Review your subscription and payment details</p>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_loadError</MudAlert>
}
else
{
    @if (ShowSubmissionCards)
    {
        <div class="billing-grid">
            <MudPaper Elevation="0" Class="dashboard-card billing-card">
                <h2 class="billing-section-title">Ringkasan Plan</h2>
                @if (_selectedPlan == null)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        Pilih plan dari halaman Upgrade Plan.
                    </MudAlert>
                }
                else
                {
                    <div class="billing-summary-row"><span class="billing-label">Plan</span><span class="billing-value">@_selectedPlan.PlanName</span></div>
                    <div class="billing-summary-row"><span class="billing-label">Harga</span><span class="billing-value">@FormatPrice(_selectedPlan.PriceAmount, _selectedPlan.PriceCurrency)</span></div>
                    <div class="billing-summary-row"><span class="billing-label">Periode</span><span class="billing-value">@FormatPeriod(_selectedPlan)</span></div>
                    <div class="billing-summary-row"><span class="billing-label">Status akun</span><span class="billing-value">@(_myPlan?.PlanName ?? "-")</span></div>
                }
            </MudPaper>

            <MudPaper Elevation="0" Class="dashboard-card billing-card">
                <h2 class="billing-section-title">Instruksi Pembayaran</h2>
                <div class="billing-summary-row"><span class="billing-label">Bank</span><span class="billing-value">@(_instructions?.BankName ?? "-")</span></div>
                <div class="billing-summary-row">
                    <span class="billing-label">No. Rekening</span>
                    <span class="billing-value billing-account">
                        @(_instructions?.AccountNumber ?? "-")
                        @if (!string.IsNullOrWhiteSpace(_instructions?.AccountNumber))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small"
                                           aria-label="Salin nomor rekening"
                                           OnClick="@(_ => CopyAccountAsync())" />
                        }
                    </span>
                </div>
                <div class="billing-summary-row"><span class="billing-label">Atas Nama</span><span class="billing-value">@(_instructions?.AccountHolder ?? "-")</span></div>
                <div class="billing-summary-row"><span class="billing-label">Nominal</span><span class="billing-value">@FormatPrice(_selectedPlan?.PriceAmount ?? 0, _selectedPlan?.PriceCurrency ?? "IDR")</span></div>
                @if (!string.IsNullOrWhiteSpace(_instructions?.Instructions))
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                        @_instructions.Instructions
                    </MudAlert>
                }
            </MudPaper>
        </div>

        <MudPaper Elevation="0" Class="dashboard-card billing-card mb-4">
            <h2 class="billing-section-title">Bukti Pembayaran</h2>

            @if (HasPendingRequest)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                    Pengajuan pembayaran Anda sedang ditinjau. Form dinonaktifkan sampai ada keputusan.
                </MudAlert>
            }

            <MudForm @ref="_form">
                <MudTextField @bind-Value="_transferReference"
                              Label="Berita transfer / nomor referensi"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Disabled="@(HasPendingRequest || _submitting)"
                              MaxLength="100"
                              Class="mb-4" />

                <MudFileUpload T="IBrowserFile"
                               Accept=".jpg,.jpeg,.png,.pdf"
                               Disabled="@(HasPendingRequest || _submitting)"
                               FilesChanged="OnFileChanged">
                    <CustomContent>
                        <div class="billing-dropzone" @onclick="@context.OpenFilePickerAsync">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" />
                            <div><strong>Pilih file bukti</strong></div>
                            <div class="billing-dropzone-hint">JPG, PNG, atau PDF — maksimum 2 MB</div>
                        </div>
                    </CustomContent>
                </MudFileUpload>

                @if (_proofFile != null)
                {
                    <div class="billing-file-pill">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                        <span class="billing-file-name">@_proofFile.Name</span>
                        <span class="billing-file-meta">@FormatFileSize(_proofFile.Size)</span>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Disabled="@_submitting"
                                       aria-label="Hapus file"
                                       OnClick="@(_ => ClearFile())" />
                    </div>
                }

                <div class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(HasPendingRequest || _submitting || _selectedPlan == null || !IsUpgradeTarget)"
                               Class="@("ryz-busy-button" + (_submitting ? " is-busy" : string.Empty))"
                               OnClick="@(_ => SubmitAsync())">
                        @(_submitting ? "Mengajukan..." : "Ajukan Pembayaran")
                    </MudButton>
                </div>
            </MudForm>
        </MudPaper>
    }

    <MudPaper Elevation="0" Class="dashboard-card billing-card mb-4">
        <h2 class="billing-section-title">Riwayat Pengajuan</h2>
        @if (_requests.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                Belum ada pengajuan pembayaran.
            </MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>No. Pengajuan</th>
                        <th>Tanggal</th>
                        <th>Plan</th>
                        <th>Nominal</th>
                        <th>Status</th>
                        <th>Catatan</th>
                        <th>Bukti</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in _requests)
                    {
                        <tr>
                            <td>@request.RequestNo</td>
                            <td>@request.CreatedDate?.ToString("dd MMM yyyy")</td>
                            <td>@request.PlanName</td>
                            <td>@FormatPrice(request.Amount, request.Currency)</td>
                            <td><MudChip T="string" Size="Size.Small" Color="@StatusColor(request.Status)" Variant="Variant.Outlined">@StatusLabel(request.Status)</MudChip></td>
                            <td>@(string.IsNullOrWhiteSpace(request.ReviewNote) ? "-" : request.ReviewNote)</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(request.ProofFileName))
                                {
                                    <MudButton Variant="Variant.Text"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Visibility"
                                               OnClick="@(_ => ShowProofAsync(request))">
                                        Lihat
                                    </MudButton>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    <MudPaper Elevation="0" Class="dashboard-card billing-card mb-4">
        <h2 class="billing-section-title">Invoice</h2>
        @if (_invoices.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                Belum ada invoice. Invoice diterbitkan setelah pembayaran disetujui.
            </MudAlert>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>No. Invoice</th>
                        <th>Tanggal</th>
                        <th>Plan</th>
                        <th>Nominal</th>
                        <th>Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in _invoices)
                    {
                        <tr>
                            <td>@invoice.InvoiceNo</td>
                            <td>@invoice.InvoiceDate.ToString("dd MMM yyyy")</td>
                            <td>@invoice.PlanName</td>
                            <td>@FormatPrice(invoice.Amount, invoice.Currency)</td>
                            <td>
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Download"
                                           Disabled="@(_downloadingInvoiceId == invoice.Id)"
                                           OnClick="@(_ => DownloadInvoiceAsync(invoice))">
                                    @(_downloadingInvoiceId == invoice.Id ? "Mengunduh..." : "PDF")
                                </MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? PlanId { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Dashboard", "/dashboard"),
        new BreadcrumbItem("Upgrade Plan", "/dashboard/upgrade-plan"),
        new BreadcrumbItem("Billing", null, disabled: true),
    };

    private MudForm? _form;
    private List<PlanDto> _plans = new();
    private List<PaymentRequestDto> _requests = new();
    private List<PaymentInvoiceDto> _invoices = new();
    private PaymentInstructionDto? _instructions;
    private EffectivePlanDto? _myPlan;
    private PlanDto? _selectedPlan;
    private IBrowserFile? _proofFile;
    private string? _transferReference;
    private bool _loading = true;
    private bool _submitting;
    private long? _downloadingInvoiceId;
    private string? _loadError;

    private bool HasPendingRequest => _requests.Any(e => string.Equals(e.Status, "PENDING", StringComparison.OrdinalIgnoreCase));

    private bool HasPaymentSubmissionIntent => !string.IsNullOrWhiteSpace(PlanId);

    private bool ShowSubmissionCards => HasPendingRequest || (HasPaymentSubmissionIntent && IsUpgradeTarget);

    private bool IsUpgradeTarget
        => _selectedPlan is not null
           && _myPlan is not null
           && !string.Equals(_selectedPlan.Id, _myPlan.Id, StringComparison.OrdinalIgnoreCase)
           && _selectedPlan.OrderSeq > _myPlan.OrderSeq
           && _selectedPlan.PriceAmount > 0;

    private string UpgradeBlockReason
    {
        get
        {
            if (_selectedPlan is null || _myPlan is null)
            {
                return "Pilih plan upgrade dari halaman Upgrade Plan.";
            }

            if (string.Equals(_selectedPlan.Id, _myPlan.Id, StringComparison.OrdinalIgnoreCase))
            {
                return "Anda sudah berada di plan ini.";
            }

            if (_selectedPlan.PriceAmount <= 0)
            {
                return "Plan gratis tidak memerlukan pengajuan bukti transfer.";
            }

            return "Plan ini tidak dapat diajukan dari halaman billing.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            var plansTask = PlanApi.GetPlansAsync();
            var myPlanTask = PlanApi.GetMyPlanAsync();
            var instructionsTask = PaymentApi.GetInstructionsAsync();
            var requestsTask = PaymentApi.GetMyRequestsAsync();
            var invoicesTask = PaymentApi.GetMyInvoicesAsync();
            await Task.WhenAll(plansTask, myPlanTask, instructionsTask, requestsTask, invoicesTask);

            _plans = await plansTask;
            _myPlan = await myPlanTask;
            _instructions = await instructionsTask;
            _requests = await requestsTask;
            _invoices = await invoicesTask ?? new List<PaymentInvoiceDto>();

            ResolveSelectedPlan();
        }
        catch (Exception exception)
        {
            _loadError = exception.Message;
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResolveSelectedPlan()
    {
        if (!string.IsNullOrWhiteSpace(PlanId))
        {
            _selectedPlan = _plans.FirstOrDefault(e => string.Equals(e.Id, PlanId, StringComparison.OrdinalIgnoreCase));
        }

        _selectedPlan ??= _plans
            .Where(IsSelectableUpgrade)
            .OrderBy(e => e.OrderSeq)
            .FirstOrDefault();

        _selectedPlan ??= _plans.FirstOrDefault(e => !IsCurrentPlan(e));
        _selectedPlan ??= _plans.FirstOrDefault();
    }

    private bool IsCurrentPlan(PlanDto plan)
        => !string.IsNullOrWhiteSpace(_myPlan?.Id)
           && string.Equals(_myPlan.Id, plan.Id, StringComparison.OrdinalIgnoreCase);

    private bool IsSelectableUpgrade(PlanDto plan)
        => _myPlan is not null
           && !IsCurrentPlan(plan)
           && plan.OrderSeq > _myPlan.OrderSeq
           && plan.PriceAmount > 0;

    private void OnFileChanged(IBrowserFile? file)
    {
        if (file == null)
        {
            return;
        }

        var extension = Path.GetExtension(file.Name);
        var allowed = new[] { ".jpg", ".jpeg", ".png", ".pdf" };
        if (!allowed.Contains(extension, StringComparer.OrdinalIgnoreCase))
        {
            Snackbar.Add("Tipe file tidak didukung. Gunakan JPG, PNG, atau PDF.", Severity.Error);
            return;
        }

        if (file.Size > 2 * 1024 * 1024)
        {
            Snackbar.Add("Ukuran file maksimum 2 MB.", Severity.Error);
            return;
        }

        _proofFile = file;
    }

    private void ClearFile() => _proofFile = null;

    private async Task SubmitAsync()
    {
        if (_selectedPlan == null)
        {
            Snackbar.Add("Pilih plan terlebih dahulu.", Severity.Warning);
            return;
        }

        if (!IsUpgradeTarget)
        {
            Snackbar.Add(UpgradeBlockReason, Severity.Warning);
            return;
        }

        if (_proofFile == null)
        {
            Snackbar.Add("Unggah bukti pembayaran terlebih dahulu.", Severity.Warning);
            return;
        }

        if (HasPendingRequest)
        {
            Snackbar.Add("Masih ada pengajuan yang menunggu review.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var response = await PaymentApi.SubmitAsync(_selectedPlan.Id, _transferReference, _proofFile);
            if (!response.Success)
            {
                Snackbar.Add(response.Message ?? "Gagal mengajukan pembayaran.", Severity.Error);
                return;
            }

            Snackbar.Add(response.Message ?? "Pengajuan pembayaran berhasil dikirim.", Severity.Success);
            _proofFile = null;
            _transferReference = null;
            _requests = await PaymentApi.GetMyRequestsAsync();
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task ShowProofAsync(PaymentRequestDto request)
    {
        var parameters = new DialogParameters<PaymentProofDialog>
        {
            { x => x.RequestId, request.Id },
            { x => x.FileName, request.ProofFileName },
            { x => x.ContentType, request.ProofContentType ?? string.Empty },
        };

        await DialogService.ShowAsync<PaymentProofDialog>("Bukti Pembayaran", parameters);
    }

    private async Task DownloadInvoiceAsync(PaymentInvoiceDto invoice)
    {
        if (_downloadingInvoiceId.HasValue)
        {
            return;
        }

        _downloadingInvoiceId = invoice.Id;
        try
        {
            var url = await PaymentApi.GetInvoiceDownloadUrlAsync(invoice.Id);
            if (string.IsNullOrWhiteSpace(url))
            {
                Snackbar.Add("Gagal menyiapkan unduhan invoice.", Severity.Error);
                return;
            }

            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _downloadingInvoiceId = null;
        }
    }

    private async Task CopyAccountAsync()
    {
        if (string.IsNullOrWhiteSpace(_instructions?.AccountNumber))
        {
            return;
        }

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _instructions.AccountNumber);
        Snackbar.Add("Nomor rekening disalin.", Severity.Success);
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private static string FormatPrice(decimal amount, string? currency)
    {
        var prefix = (currency ?? "IDR").Trim().ToUpperInvariant() switch
        {
            "IDR" => "Rp ",
            "USD" => "$",
            var c => c + " "
        };
        return prefix + amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("id-ID"));
    }

    private static string FormatPeriod(PlanDto plan)
    {
        if (plan.PriceAmount <= 0) return "Gratis";
        var period = plan.BillingPeriod?.Trim().ToUpperInvariant();
        var interval = plan.BillingIntervalCount <= 0 ? 1 : plan.BillingIntervalCount;
        return period switch
        {
            "MONTHLY" when interval == 1 => "/ bulan",
            "MONTHLY" => $"/ {interval} bulan",
            "YEARLY" when interval == 1 => "/ tahun",
            "YEARLY" => $"/ {interval} tahun",
            _ => "Sekali bayar",
        };
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1024 * 1024) return (bytes / 1024d).ToString("0.#") + " KB";
        return (bytes / (1024d * 1024d)).ToString("0.#") + " MB";
    }

    private static Color StatusColor(string? status) => (status ?? string.Empty).ToUpperInvariant() switch
    {
        "PENDING" => Color.Warning,
        "APPROVED" => Color.Success,
        "REJECTED" => Color.Error,
        _ => Color.Default,
    };

    private static string StatusLabel(string? status) => (status ?? string.Empty).ToUpperInvariant() switch
    {
        "PENDING" => "Menunggu",
        "APPROVED" => "Disetujui",
        "REJECTED" => "Ditolak",
        _ => status ?? "-",
    };
}
