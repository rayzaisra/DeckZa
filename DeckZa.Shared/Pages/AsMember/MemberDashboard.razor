@using DeckZa.Application.DTOs.Tasks
@implements IDisposable
@inject ReportApiService ReportApi
@inject TaskApiService TaskApi
@inject TabStateService TabService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject LanguageService L
@using System.Globalization

@if (ShowUpgradeBanner)
{
    <section class="bento-upgrade-banner">
        <div class="bento-upgrade-banner-copy">
            <div class="dashboard-kicker">@L["GuestPlan"]</div>
            <h3>@L["UpgradeToMember"]</h3>
            <p>@L["UpgradeBannerBenefits"]</p>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   OnClick="@(_ => OpenTab("UpgradePlanTitle", UpgradePlanComponent, "/dashboard/upgrade-plan", "WorkspacePremium"))">
            @L["UpgradePlanTitle"]
        </MudButton>
    </section>
}

<div class="bento-dashboard @(_loading ? "ryz-bento-skeleton" : string.Empty)">
    <section class="bento-card bento-greeting">
        <div class="bento-greeting-copy">
            <div class="dashboard-kicker">@L["PersonalTaskAndReportManagement"]</div>
            <h1>@L.Format("HelloName", _displayName)</h1>
            <p>@L.Format("DashboardWelcomeBack", CurrentMonthLabel)</p>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.WavingHand" Class="bento-greeting-icon" />
    </section>

    @if (_loading)
    {
        @for (var skeleton = 0; skeleton < 5; skeleton++)
        {
            <section class="bento-card" aria-hidden="true">
                <div class="ryz-bento-skeleton-line is-title"></div>
                <div class="ryz-bento-skeleton-line"></div>
                <div class="ryz-bento-skeleton-line is-short"></div>
            </section>
        }
    }
    else
    {

    <section class="bento-card bento-calendar">
        <header class="bento-head">
            <div>
                <div class="dashboard-kicker">@L["CalendarTitle"]</div>
                <h3>@CurrentMonthLabel</h3>
            </div>
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Size="Size.Small"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(_ => OpenTab("CalendarTitle", CalendarComponent, "/dashboard/calendar", "CalendarToday"))">
                @L["Detail"]
            </MudButton>
        </header>

        <div class="bento-calendar-weekdays">
            @foreach (var day in WeekdayLabels)
            {
                <span>@day</span>
            }
        </div>
        <div class="bento-calendar-grid">
            @foreach (var cell in _monthCells)
            {
                <div class="bento-calendar-cell @(cell.IsCurrentMonth ? string.Empty : "is-outside") @(cell.IsToday ? "is-today" : string.Empty) @(cell.TaskCount > 0 ? "has-task" : string.Empty)">
                    <span class="bento-calendar-day">@cell.Date.Day</span>
                    @if (cell.TaskCount > 0)
                    {
                        <span class="bento-calendar-dot" aria-hidden="true"></span>
                    }
                </div>
            }
        </div>
    </section>

    <section class="bento-card bento-total">
        <header class="bento-head">
            <div>
                <div class="dashboard-kicker">@L["TotalTask"]</div>
                <h2>@_monthTaskCount</h2>
            </div>
            <span class="bento-hint">@CurrentMonthLabel</span>
        </header>
        <BentoBarChart Bars="_dailyBars" AriaLabel="@L.Format("TaskPerDayAria", CurrentMonthLabel)" />
    </section>

    <section class="bento-card bento-status">
        <header class="bento-head">
            <div>
                <div class="dashboard-kicker">@L["Status"]</div>
            </div>
            <span class="bento-hint">@L.Format("TotalLower", _monthTaskCount)</span>
        </header>
        @if (_statusSlices.Count == 0)
        {
            <div class="bento-empty">@L["NoStatusDataThisMonth"]</div>
        }
        else
        {
            <BentoPieChart Slices="_statusSlices"
                           Total="_monthTaskCount"
                           AriaLabel="@L.Format("StatusBreakdownAria", CurrentMonthLabel)"
                           EmptyText="@L["NoStatusDataThisMonth"]" />
        }
    </section>

    <section class="bento-card bento-speed">
        <header class="bento-head">
            <div>
                <div class="dashboard-kicker">@L["Speed"]</div>
            </div>
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Size="Size.Small"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(_ => OpenTab("ReportTitle", ReportComponent, "/dashboard/report", "BarChart"))">
                @L["AdvancedAnalysis"]
            </MudButton>
        </header>
        <div class="bento-speed-list">
            <div class="bento-speed-row">
                <span class="dashboard-kicker">@L["SpeedMedian"]</span>
                <span class="bento-speed-value">@FormatHours(_speed.MedianMinutes)</span>
            </div>
            <div class="bento-speed-row">
                <span class="dashboard-kicker">@L["SpeedAverage"]</span>
                <span class="bento-speed-value">@FormatHours(_speed.AverageMinutes)</span>
            </div>
            <div class="bento-speed-row">
                <span class="dashboard-kicker">@L["SpeedWithinOneHour"]</span>
                <span class="bento-speed-value">@FormatPercent(_speed.PercentWithinOneHour)</span>
            </div>
            <div class="bento-speed-row">
                <span class="dashboard-kicker">@L["SpeedValidDuration"]</span>
                <span class="bento-speed-value">@_speed.ValidTaskCount / @_speed.DoneCount</span>
            </div>
        </div>
    </section>

    <section class="bento-card bento-tasks">
        <header class="bento-head">
            <div>
                <div class="dashboard-kicker">@L["Task"]</div>
                <h3>@L["NextUp"]</h3>
            </div>
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Size="Size.Small"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       OnClick="@(_ => OpenTab("Menu.TSK-KANBAN", KanbanComponent, "/dashboard/task-management", "Checklist"))">
                @L["TaskManagementLink"]
            </MudButton>
        </header>

        @if (_openTasks.Count == 0)
        {
            <div class="bento-empty">@L["NoOpenTaskRightNow"]</div>
        }
        else
        {
            <div class="bento-task-list">
                @foreach (var task in _openTasks)
                {
                    <article class="bento-task">
                        <div class="bento-task-title">@task.Title</div>
                        <div class="bento-task-meta">
                            @if (!string.IsNullOrWhiteSpace(task.ApplicationName))
                            {
                                <span class="kanban-chip">@task.ApplicationName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(task.TaskTypeName))
                            {
                                <span class="kanban-chip">@task.TaskTypeName</span>
                            }
                            <span class="kanban-chip">@task.StatusName</span>
                            @if (!string.IsNullOrWhiteSpace(task.TaskPriorityName))
                            {
                                <span class="kanban-priority">@task.TaskPriorityName</span>
                            }
                            @if (task.DueDate.HasValue)
                            {
                                <span class="bento-task-due @(task.IsOverdue ? "is-overdue" : string.Empty)">@L.Format("DueAt", task.DueDate.Value.ToString("dd MMM HH:mm"))</span>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>
    }
</div>

@code {
    [Parameter] public bool ShowUpgradeBanner { get; set; }

    private string[] WeekdayLabels => new[]
    {
        L["WeekdayMon"], L["WeekdayTue"], L["WeekdayWed"], L["WeekdayThu"],
        L["WeekdayFri"], L["WeekdaySat"], L["WeekdaySun"],
    };

    private const string KanbanComponent = "DeckZa.Shared.Pages.AsMember.Kanban, DeckZa.Shared";
    private const string CalendarComponent = "DeckZa.Shared.Pages.AsMember.Calendar, DeckZa.Shared";
    private const string ReportComponent = "DeckZa.Shared.Pages.AsMember.Report, DeckZa.Shared";
    private const string UpgradePlanComponent = "DeckZa.Shared.Pages.AsMember.UpgradePlan, DeckZa.Shared";

    private readonly List<BentoMonthCell> _monthCells = new();
    private readonly List<TaskListItemDto> _openTasks = new();
    private readonly List<BentoBar> _dailyBars = new();
    private readonly List<BentoPieSlice> _statusSlices = new();
    private ReportSpeedDto _speed = new();

    private string _displayName = "Member";
    private int _monthTaskCount;
    private bool _loading = true;

    private DateTime Today => DateTime.Today;

    private DateTime MonthStart => new(Today.Year, Today.Month, 1);

    private DateTime MonthEndExclusive => MonthStart.AddMonths(1);

    private string CurrentMonthLabel => MonthStart.ToString("MMMM yyyy", CultureInfo.CurrentCulture);

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var name = authState.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            _displayName = name;
        }

        _ = LoadAsync();
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private void OpenTab(string titleKey, string componentType, string url, string icon)
        => TabService.OpenTab(L[titleKey], componentType, url, icon: icon, titleKey: titleKey);

    private async Task LoadAsync()
    {
        try
        {
            var reportTask = ReportApi.PreviewAsync(new ReportFilterDto
            {
                DateFrom = MonthStart,
                DateTo = MonthEndExclusive.AddDays(-1),
            });

            var boardTask = TaskApi.GetBoardAsync(new TaskBoardRequestDto());

            await Task.WhenAll(reportTask, boardTask);

            var report = await reportTask;
            if (report != null)
            {
                _speed = report.Speed;
                BuildStatusSlices(report.StatusBreakdown);
            }

            var board = await boardTask;

            var monthTasks = board
                .Where(task => task.RequestDate >= MonthStart && task.RequestDate < MonthEndExclusive)
                .ToList();

            _monthTaskCount = monthTasks.Count;
            BuildDailyVolume(monthTasks);
            BuildMonthCells(board);

            _openTasks.Clear();
            _openTasks.AddRange(board
                .Where(task => !task.IsCompletedStatus)
                .OrderBy(task => task.DueDate ?? DateTime.MaxValue)
                .ThenBy(task => task.RequestDate)
                .Take(5));

        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void BuildStatusSlices(List<ReportStatusBreakdownDto> breakdown)
    {
        _statusSlices.Clear();

        var items = breakdown
            .OrderBy(item => item.OrderSeq)
            .Select(item => (
                Label: item.StatusName,
                item.Count,
                Color: $"var(--kanban-tone-{((item.OrderSeq - 1) % 5) + 1})"))
            .ToList();

        _statusSlices.AddRange(BentoPieSlice.Build(items));
    }

    private void BuildDailyVolume(List<TaskListItemDto> monthTasks)
    {
        var daysInMonth = DateTime.DaysInMonth(MonthStart.Year, MonthStart.Month);
        var counts = new int[daysInMonth];

        foreach (var task in monthTasks)
        {
            var index = task.RequestDate.Day - 1;
            if (index >= 0 && index < counts.Length)
            {
                counts[index]++;
            }
        }

        var peak = counts.Length == 0 ? 0 : counts.Max();
        const double plotHeight = 120d;
        _dailyBars.Clear();

        for (var day = 1; day <= daysInMonth; day++)
        {
            var count = counts[day - 1];
            _dailyBars.Add(new BentoBar
            {
                Label = day.ToString(),
                Count = count,
                HeightPixels = peak == 0
                    ? 0
                    : Math.Max(count * plotHeight / peak, count > 0 ? 8d : 0d),
                ShowLabel = day == 1 || day == daysInMonth || day % 5 == 0,
            });
        }
    }

    private void BuildMonthCells(List<TaskListItemDto> board)
    {
        _monthCells.Clear();

        var taskDays = board
            .Where(task => task.DueDate.HasValue
                           && task.DueDate.Value >= MonthStart
                           && task.DueDate.Value < MonthEndExclusive)
            .GroupBy(task => task.DueDate!.Value.Date)
            .ToDictionary(group => group.Key, group => group.Count());

        var offset = ((int)MonthStart.DayOfWeek + 6) % 7;
        var start = MonthStart.AddDays(-offset);

        for (var index = 0; index < 42; index++)
        {
            var date = start.AddDays(index);
            _monthCells.Add(new BentoMonthCell
            {
                Date = date,
                IsCurrentMonth = date.Month == MonthStart.Month && date.Year == MonthStart.Year,
                IsToday = date.Date == Today,
                TaskCount = taskDays.TryGetValue(date.Date, out var count) ? count : 0,
            });
        }
    }

    private static string FormatPercent(decimal value)
        => value.ToString("0.0", CultureInfo.InvariantCulture) + "%";

    private string FormatHours(decimal? minutes)
        => minutes.HasValue
            ? L.Format("DurationHours", (minutes.Value / 60m).ToString("0.0", CultureInfo.InvariantCulture))
            : "–";

    private sealed class BentoMonthCell
    {
        public DateTime Date { get; init; }
        public bool IsCurrentMonth { get; init; }
        public bool IsToday { get; init; }
        public int TaskCount { get; init; }
    }

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
