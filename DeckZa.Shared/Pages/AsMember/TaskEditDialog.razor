@using DeckZa.Application.DTOs.Tasks
@implements IDisposable
@inject ISnackbar Snackbar
@inject LanguageService L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@DialogTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Title"
                                  Label="@L["Title"]"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Disabled="@IsReadOnly" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.ApplicationId"
                               Label="@L["Application"]"
                               Variant="Variant.Outlined"
                               Required="true"
                               Disabled="@IsReadOnly">
                        @foreach (var item in Applications)
                        {
                            <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.RequestBy"
                                  Label="@L["RequestBy"]"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Disabled="@IsReadOnly" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_requestDate"
                                   Label="@L["RequestDate"]"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   Disabled="@IsReadOnly" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker @bind-Time="_requestTime"
                                   Label="@L["RequestTime"]"
                                   Variant="Variant.Outlined"
                                   Disabled="@IsReadOnly" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.TaskTypeId"
                               Label="@L["TaskType"]"
                               Variant="Variant.Outlined"
                               Required="true"
                               Disabled="@IsReadOnly">
                        @foreach (var item in TaskTypes)
                        {
                            <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.TaskPriorityId"
                               Label="@L["Priority"]"
                               Variant="Variant.Outlined"
                               Required="true"
                               Disabled="@IsReadOnly">
                        @foreach (var item in TaskPriorities)
                        {
                            <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               @bind-Value="_model.StatusId"
                               Label="@L["Status"]"
                               Variant="Variant.Outlined"
                               Required="true"
                               Disabled="@IsReadOnly">
                        @foreach (var item in TaskStatuses)
                        {
                            <MudSelectItem Value="@item.Value">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_dueDate"
                                   Label="@L["DueDate"]"
                                   Variant="Variant.Outlined"
                                   Disabled="@IsReadOnly" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTimePicker @bind-Time="_dueTime"
                                   Label="@L["DueTime"]"
                                   Variant="Variant.Outlined"
                                   Disabled="@IsReadOnly" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Description"
                                  Label="@L["Description"]"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Disabled="@IsReadOnly" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (IsReadOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(_ => MudDialog.Close())">@L["Close"]</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(_ => MudDialog.Cancel())">@L["Cancel"]</MudButton>
            <PermissionGate Action="PermissionAction.AddEdit">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="@("ryz-busy-button" + (_saving ? " is-busy" : string.Empty))" Disabled="@_saving" OnClick="@(_ => SubmitAsync())">
                    @(_saving ? L["Saving"] : L["Save"])
                </MudButton>
            </PermissionGate>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public TaskEditDto? Model { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public string? DefaultStatusId { get; set; }

    [Parameter]
    public List<DropdownItemDto> Applications { get; set; } = new();

    [Parameter]
    public List<DropdownItemDto> TaskTypes { get; set; } = new();

    [Parameter]
    public List<DropdownItemDto> TaskPriorities { get; set; } = new();

    [Parameter]
    public List<DropdownItemDto> TaskStatuses { get; set; } = new();

    private MudForm? _form;
    private TaskEditDto _model = new();
    private DateTime? _requestDate;
    private TimeSpan? _requestTime;
    private DateTime? _dueDate;
    private TimeSpan? _dueTime;
    private bool _saving;

    private string DialogTitle => IsReadOnly ? L["TaskDetail"] : IsEdit ? L["EditTask"] : L["NewTask"];

    protected override void OnInitialized()
    {
        L.OnChange += HandleLanguageChanged;

        _model = Model == null
            ? new TaskEditDto
            {
                RequestDate = DateTime.Now,
                StatusId = DefaultStatusId ?? string.Empty,
            }
            : new TaskEditDto
            {
                Title = Model.Title,
                Description = Model.Description,
                ApplicationId = Model.ApplicationId,
                RequestBy = Model.RequestBy,
                RequestDate = Model.RequestDate,
                DueDate = Model.DueDate,
                StatusId = Model.StatusId,
                TaskTypeId = Model.TaskTypeId,
                TaskPriorityId = Model.TaskPriorityId,
            };

        _requestDate = _model.RequestDate == default ? DateTime.Today : _model.RequestDate.Date;
        _requestTime = _model.RequestDate == default ? DateTime.Now.TimeOfDay : _model.RequestDate.TimeOfDay;

        if (_model.DueDate.HasValue)
        {
            _dueDate = _model.DueDate.Value.Date;
            _dueTime = _model.DueDate.Value.TimeOfDay;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task SubmitAsync()
    {
        if (_saving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            Snackbar.Add(L["TitleRequired"], Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.ApplicationId))
        {
            Snackbar.Add(L["ApplicationRequired"], Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.RequestBy))
        {
            Snackbar.Add(L["RequestByRequired"], Severity.Warning);
            return;
        }

        if (_requestDate == null)
        {
            Snackbar.Add(L["RequestDateRequired"], Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.TaskTypeId))
        {
            Snackbar.Add(L["TaskTypeRequired"], Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.TaskPriorityId))
        {
            Snackbar.Add(L["PriorityRequired"], Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.StatusId))
        {
            Snackbar.Add(L["StatusRequired"], Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            _model.RequestDate = _requestDate.Value.Date + (_requestTime ?? TimeSpan.Zero);
            _model.DueDate = _dueDate.HasValue
                ? _dueDate.Value.Date + (_dueTime ?? new TimeSpan(23, 59, 0))
                : null;

            MudDialog.Close(DialogResult.Ok(_model));
        }
        finally
        {
            _saving = false;
        }

        await Task.CompletedTask;
    }

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
