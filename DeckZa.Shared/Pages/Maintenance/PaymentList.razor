@page "/dashboard/maintenance/payment-list"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject PaymentApiService PaymentApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject LanguageService L

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">@L["Payment"]</div>
        <h1>@L["PaymentRequests"]</h1>
        <p>@L["PaymentRequestsSubtitle"]</p>
    </div>
</div>

<MudPaper Elevation="0" Class="dashboard-card">
    <MudTable T="PaymentApprovalListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudSelect T="string" @bind-Value="_status" Label="@L["Status"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Dense="true" Style="min-width:180px;" Class="mr-2"
                       SelectedValuesChanged="OnStatusChanged">
                <MudSelectItem T="string" Value="@string.Empty">@L["All"]</MudSelectItem>
                <MudSelectItem T="string" Value="@PaymentStatusPending">@L["StatusPending"]</MudSelectItem>
                <MudSelectItem T="string" Value="@PaymentStatusApproved">@L["StatusApproved"]</MudSelectItem>
                <MudSelectItem T="string" Value="@PaymentStatusRejected">@L["StatusRejected"]</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="@L["Search"]"
                          Placeholder="@L["SearchByRequestNoUser"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="approval-search" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="requestno">@L["RequestNo"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="userid">@L["User"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="planname">@L["Plan"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="amount">@L["Amount"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="createddate">@L["Date"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="status">@L["Status"]</MudTableSortLabel></MudTh>
            <MudTh>@L["Invoice"]</MudTh>
            <MudTh Style="text-align:center;">@L["Action"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["RequestNo"]">@context.RequestNo</MudTd>
            <MudTd DataLabel="@L["User"]">
                <div>@(context.UserName ?? context.UserId)</div>
                @if (!string.IsNullOrWhiteSpace(context.UserId) && context.UserName != context.UserId)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.UserId</MudText>
                }
            </MudTd>
            <MudTd DataLabel="@L["Plan"]">@(context.PlanName ?? context.PlanId)</MudTd>
            <MudTd DataLabel="@L["Amount"]">@FormatAmount(context.Amount, context.Currency)</MudTd>
            <MudTd DataLabel="@L["Date"]">@(context.CreatedDate?.ToString("dd MMM yyyy") ?? "-")</MudTd>
            <MudTd DataLabel="@L["Status"]">
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@StatusLabel(context.Status)</MudChip>
            </MudTd>
            <MudTd DataLabel="@L["Invoice"]">
                @if (context.InvoiceId.HasValue)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download"
                               Disabled="@(_downloadingInvoiceId == context.InvoiceId)"
                               OnClick="@(() => DownloadInvoiceAsync(context))">
                        @(_downloadingInvoiceId == context.InvoiceId ? L["DownloadingInvoice"] : (context.InvoiceNo ?? "PDF"))
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                }
            </MudTd>
            <MudTd DataLabel="@L["Action"]" Style="text-align:center;">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Visibility"
                           OnClick="@(() => ShowProofAsync(context))">@L["Proof"]</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["NoPaymentRequestsFound"]</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" RowsPerPageString="@L["RowsPerPage"]" InfoFormat="@L["PagerInfoFormat"]" AllItemsText="@L["AllItems"]" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private const string PaymentStatusPending = "PENDING";
    private const string PaymentStatusApproved = "APPROVED";
    private const string PaymentStatusRejected = "REJECTED";

    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["Dashboard"], href: "/dashboard"),
        new(L["Payment"], href: null),
        new(L["List"], href: null, disabled: true),
    };

    private MudTable<PaymentApprovalListItemDto>? _table;
    private string? _search;
    private string _status = string.Empty;
    private long? _downloadingInvoiceId;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task<TableData<PaymentApprovalListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await PaymentApi.GetAdminListAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        }, _status, cancellationToken);

        return new TableData<PaymentApprovalListItemDto>
        {
            Items = response.Data ?? new List<PaymentApprovalListItemDto>(),
            TotalItems = response.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OnStatusChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task ShowProofAsync(PaymentApprovalListItemDto item)
    {
        var parameters = new DialogParameters<PaymentProofDialog>
        {
            { x => x.RequestId, item.Id },
            { x => x.FileName, item.ProofFileName },
            { x => x.ContentType, item.ProofContentType },
        };

        await DialogService.ShowAsync<PaymentProofDialog>(L["PaymentProofTitle"], parameters);
    }

    private async Task DownloadInvoiceAsync(PaymentApprovalListItemDto item)
    {
        if (!item.InvoiceId.HasValue || _downloadingInvoiceId.HasValue)
        {
            return;
        }

        _downloadingInvoiceId = item.InvoiceId.Value;
        try
        {
            var url = await PaymentApi.GetInvoiceDownloadUrlAsync(item.InvoiceId.Value);
            if (string.IsNullOrWhiteSpace(url))
            {
                Snackbar.Add(L["FailedPrepareInvoiceDownload"], Severity.Error);
                return;
            }

            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _downloadingInvoiceId = null;
        }
    }

    private static string FormatAmount(decimal amount, string currency)
        => $"{currency} {amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("id-ID"))}";

    private static Color StatusColor(string status) => status switch
    {
        PaymentStatusApproved => Color.Success,
        PaymentStatusRejected => Color.Error,
        _ => Color.Warning,
    };

    private string StatusLabel(string status) => status switch
    {
        PaymentStatusPending => L["StatusPending"],
        PaymentStatusApproved => L["StatusApproved"],
        PaymentStatusRejected => L["StatusRejected"],
        _ => status,
    };

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
