@page "/dashboard/maintenance/payment-list"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject PaymentApiService PaymentApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">Payment</div>
        <h1>Payment Requests</h1>
        <p>Review every payment submission and its proof of transfer.</p>
    </div>
</div>

<MudPaper Elevation="0" Class="dashboard-card">
    <MudTable T="PaymentApprovalListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudSelect T="string" @bind-Value="_status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Dense="true" Style="min-width:180px;" Class="mr-2"
                       SelectedValuesChanged="OnStatusChanged">
                <MudSelectItem T="string" Value="@string.Empty">All</MudSelectItem>
                <MudSelectItem T="string" Value="@PaymentStatusPending">Pending</MudSelectItem>
                <MudSelectItem T="string" Value="@PaymentStatusApproved">Approved</MudSelectItem>
                <MudSelectItem T="string" Value="@PaymentStatusRejected">Rejected</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="Search"
                          Placeholder="Search by request no, user..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="approval-search" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="requestno">Request No.</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="userid">User</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="planname">Plan</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="amount">Amount</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="createddate">Date</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="status">Status</MudTableSortLabel></MudTh>
            <MudTh>Invoice</MudTh>
            <MudTh Style="text-align:center;">Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Request No.">@context.RequestNo</MudTd>
            <MudTd DataLabel="User">
                <div>@(context.UserName ?? context.UserId)</div>
                @if (!string.IsNullOrWhiteSpace(context.UserId) && context.UserName != context.UserId)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.UserId</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Plan">@(context.PlanName ?? context.PlanId)</MudTd>
            <MudTd DataLabel="Amount">@FormatAmount(context.Amount, context.Currency)</MudTd>
            <MudTd DataLabel="Date">@(context.CreatedDate?.ToString("dd MMM yyyy") ?? "-")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
            </MudTd>
            <MudTd DataLabel="Invoice">
                @if (context.InvoiceId.HasValue)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download"
                               Disabled="@(_downloadingInvoiceId == context.InvoiceId)"
                               OnClick="@(() => DownloadInvoiceAsync(context))">
                        @(_downloadingInvoiceId == context.InvoiceId ? "Downloading..." : (context.InvoiceNo ?? "PDF"))
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Action" Style="text-align:center;">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Visibility"
                           OnClick="@(() => ShowProofAsync(context))">Proof</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No payment requests found.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private const string PaymentStatusPending = "PENDING";
    private const string PaymentStatusApproved = "APPROVED";
    private const string PaymentStatusRejected = "REJECTED";

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Dashboard", href: "/dashboard"),
        new("Payment", href: null),
        new("List", href: null, disabled: true),
    ];

    private MudTable<PaymentApprovalListItemDto>? _table;
    private string? _search;
    private string _status = string.Empty;
    private long? _downloadingInvoiceId;

    private async Task<TableData<PaymentApprovalListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await PaymentApi.GetAdminListAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        }, _status, cancellationToken);

        return new TableData<PaymentApprovalListItemDto>
        {
            Items = response.Data ?? new List<PaymentApprovalListItemDto>(),
            TotalItems = response.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OnStatusChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task ShowProofAsync(PaymentApprovalListItemDto item)
    {
        var parameters = new DialogParameters<PaymentProofDialog>
        {
            { x => x.RequestId, item.Id },
            { x => x.FileName, item.ProofFileName },
            { x => x.ContentType, item.ProofContentType },
        };

        await DialogService.ShowAsync<PaymentProofDialog>("Payment Proof", parameters);
    }

    private async Task DownloadInvoiceAsync(PaymentApprovalListItemDto item)
    {
        if (!item.InvoiceId.HasValue || _downloadingInvoiceId.HasValue)
        {
            return;
        }

        _downloadingInvoiceId = item.InvoiceId.Value;
        try
        {
            var url = await PaymentApi.GetInvoiceDownloadUrlAsync(item.InvoiceId.Value);
            if (string.IsNullOrWhiteSpace(url))
            {
                Snackbar.Add("Failed to prepare invoice download.", Severity.Error);
                return;
            }

            Navigation.NavigateTo(url, forceLoad: true);
        }
        catch (Exception exception)
        {
            Snackbar.Add(exception.Message, Severity.Error);
        }
        finally
        {
            _downloadingInvoiceId = null;
        }
    }

    private static string FormatAmount(decimal amount, string currency)
        => $"{currency} {amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("id-ID"))}";

    private static Color StatusColor(string status) => status switch
    {
        PaymentStatusApproved => Color.Success,
        PaymentStatusRejected => Color.Error,
        _ => Color.Warning,
    };
}
