@page "/dashboard/maintenance/payment-approval"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@inject PaymentApiService PaymentApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject LanguageService L

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">@L["Payment"]</div>
        <h1>@L["PaymentApprovalPageTitle"]</h1>
        <p>@L["PaymentApprovalPageSubtitle"]</p>
    </div>
    <PermissionGate Action="PermissionAction.Approve">
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.DoneAll" OnClick="ApproveAll">@L["ApproveAllAction"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DoNotDisturb" OnClick="RejectAll">@L["RejectAllAction"]</MudButton>
        </div>
    </PermissionGate>
</div>

<MudPaper Elevation="0" Class="dashboard-card">
    <MudTable T="PaymentApprovalListItemDto"
              @ref="_table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="false"
              Breakpoint="Breakpoint.Sm"
              Elevation="0"
              HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_search"
                          @bind-Value:after="OnSearchChanged"
                          Label="@L["Search"]"
                          Placeholder="@L["SearchByRequestNoUser"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="approval-search" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="requestno">@L["RequestNo"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="userid">@L["User"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="planname">@L["Plan"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="PaymentApprovalListItemDto" SortLabel="amount">@L["Amount"]</MudTableSortLabel></MudTh>
            <MudTh Style="text-align:center;">@L["Proof"]</MudTh>
            <PermissionGate AnyOf="PermissionSets.ApproveReject">
                <MudTh Style="text-align:center;">@L["Action"]</MudTh>
            </PermissionGate>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["RequestNo"]">@context.RequestNo</MudTd>
            <MudTd DataLabel="@L["User"]">
                <div>@(context.UserName ?? context.UserId)</div>
                @if (!string.IsNullOrWhiteSpace(context.UserId) && context.UserName != context.UserId)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.UserId</MudText>
                }
            </MudTd>
            <MudTd DataLabel="@L["Plan"]">@(context.PlanName ?? context.PlanId)</MudTd>
            <MudTd DataLabel="@L["Amount"]">@FormatAmount(context.Amount, context.Currency)</MudTd>
            <MudTd DataLabel="@L["Proof"]" Style="text-align:center;">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Visibility"
                           OnClick="@(() => ShowProofAsync(context))">@L["View"]</MudButton>
            </MudTd>
            <PermissionGate AnyOf="PermissionSets.ApproveReject">
                <MudTd DataLabel="@L["Action"]" Style="text-align:center;">
                    <MudRadioGroup @bind-Value="context.SelectedAction" Class="approval-radios">
                        <MudRadio T="int" Value="1" Color="Color.Primary">@L["Approve"]</MudRadio>
                        <MudRadio T="int" Value="2" Color="Color.Default">@L["Pending"]</MudRadio>
                        <MudRadio T="int" Value="0" Color="Color.Error">@L["Reject"]</MudRadio>
                    </MudRadioGroup>
                </MudTd>
            </PermissionGate>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["NoPendingPaymentRequests"]</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" />
        </LoadingContent>
        <PagerContent>
            <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" RowsPerPageString="@L["RowsPerPage"]" InfoFormat="@L["PagerInfoFormat"]" AllItemsText="@L["AllItems"]" />
        </PagerContent>
    </MudTable>

    <PermissionGate Action="PermissionAction.Approve">
        <div class="d-flex justify-center mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Gavel" Class="@("ryz-busy-button" + (_submitting ? " is-busy" : string.Empty))" Disabled="@_submitting" OnClick="SubmitApprovalsAsync">
                @(_submitting ? L["Submitting"] : L["Submit"])
            </MudButton>
        </div>
    </PermissionGate>
</MudPaper>

@code {
    private const string PaymentStatusPending = "PENDING";

    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new(L["Dashboard"], href: "/dashboard"),
        new(L["Payment"], href: null),
        new(L["Approval"], href: null, disabled: true),
    };

    private MudTable<PaymentApprovalListItemDto>? _table;
    private List<PaymentApprovalListItemDto> _currentItems = new();
    private string? _search;
    private bool _submitting;

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    private async Task<TableData<PaymentApprovalListItemDto>> LoadServerData(TableState state, CancellationToken cancellationToken)
    {
        var response = await PaymentApi.GetAdminListAsync(new DataTableRequestDto
        {
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SearchTerm = _search,
            SortColumn = state.SortLabel,
            SortDirection = state.SortDirection == SortDirection.Descending ? "desc" : "asc",
        }, PaymentStatusPending, cancellationToken);

        _currentItems = response.Data ?? new List<PaymentApprovalListItemDto>();
        foreach (var item in _currentItems)
        {
            item.SelectedAction = 2;
        }

        return new TableData<PaymentApprovalListItemDto>
        {
            Items = _currentItems,
            TotalItems = response.TotalCount,
        };
    }

    private async Task OnSearchChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private void ApproveAll()
    {
        foreach (var item in _currentItems)
        {
            item.SelectedAction = 1;
        }
        StateHasChanged();
    }

    private void RejectAll()
    {
        foreach (var item in _currentItems)
        {
            item.SelectedAction = 0;
        }
        StateHasChanged();
    }

    private async Task ShowProofAsync(PaymentApprovalListItemDto item)
    {
        var parameters = new DialogParameters<PaymentProofDialog>
        {
            { x => x.RequestId, item.Id },
            { x => x.FileName, item.ProofFileName },
            { x => x.ContentType, item.ProofContentType },
        };

        await DialogService.ShowAsync<PaymentProofDialog>(L["PaymentProofTitle"], parameters);
    }

    private async Task SubmitApprovalsAsync()
    {
        if (_submitting)
        {
            return;
        }

        var approveItems = _currentItems.Where(x => x.SelectedAction == 1).ToList();
        var rejectItems = _currentItems.Where(x => x.SelectedAction == 0).ToList();

        if (approveItems.Count == 0 && rejectItems.Count == 0)
        {
            Snackbar.Add(L["NoApprovalsSelected"], Severity.Warning);
            return;
        }

        // Kumpulkan keputusan/catatan dulu sebelum busy overlay aktif.
        // Overlay proses global menutup layar penuh; bila dialog dibuka saat
        // _submitting true, dialog tertutup overlay dan user tidak bisa
        // konfirmasi/batal (progress tampak berhenti di 92%).
        var confirmedApprovals = new List<(PaymentApprovalListItemDto Item, string Note)>();
        foreach (var item in approveItems)
        {
            var note = await AskNoteAsync(
                L["ApprovePaymentRequest"],
                L.Format("ApprovePaymentMessage", item.RequestNo, item.PlanName ?? item.PlanId, FormatAmount(item.Amount, item.Currency)),
                L["Approve"],
                Color.Success,
                L["OptionalNoteForApplicant"]);

            if (note == null)
            {
                continue;
            }

            confirmedApprovals.Add((item, note));
        }

        var confirmedRejections = new List<(PaymentApprovalListItemDto Item, string Note)>();
        foreach (var item in rejectItems)
        {
            var note = await AskNoteAsync(
                L["RejectPaymentRequest"],
                L.Format("RejectPaymentMessage", item.RequestNo, item.PlanName ?? item.PlanId, FormatAmount(item.Amount, item.Currency)),
                L["Reject"],
                Color.Error,
                L["ReasonShownToApplicant"]);

            if (note == null)
            {
                continue;
            }

            confirmedRejections.Add((item, note));
        }

        if (confirmedApprovals.Count == 0 && confirmedRejections.Count == 0)
        {
            return;
        }

        var failed = 0;
        var processed = 0;
        _submitting = true;

        try
        {
            foreach (var (item, note) in confirmedApprovals)
            {
                var response = await PaymentApi.ApproveAsync(item.Id, note);
                if (response.Success)
                {
                    processed++;
                }
                else
                {
                    failed++;
                    Snackbar.Add(ResponseText(response, "ApprovalFailedFor", item.RequestNo), Severity.Error);
                }
            }

            foreach (var (item, note) in confirmedRejections)
            {
                var response = await PaymentApi.RejectAsync(item.Id, note);
                if (response.Success)
                {
                    processed++;
                }
                else
                {
                    failed++;
                    Snackbar.Add(ResponseText(response, "RejectionFailedFor", item.RequestNo), Severity.Error);
                }
            }

            if (failed == 0 && processed > 0)
            {
                Snackbar.Add(L["ApprovalProcessedSuccess"], Severity.Success);
            }
            else if (processed > 0 && failed > 0)
            {
                Snackbar.Add(L.Format("ProcessedAndFailed", processed, failed), Severity.Warning);
            }

            if (_table != null && processed > 0)
            {
                await _table.ReloadServerData();
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>
    /// Membuka dialog konfirmasi berisi kolom catatan. Mengembalikan null bila
    /// admin membatalkan dialog.
    /// </summary>
    private async Task<string?> AskNoteAsync(string title, string message, string confirmText, Color color, string placeholder)
    {
        var parameters = new DialogParameters<PaymentReviewDialog>
        {
            { x => x.Title, title },
            { x => x.Message, message },
            { x => x.ConfirmText, confirmText },
            { x => x.ConfirmColor, color },
            { x => x.Placeholder, placeholder },
        };

        var dialog = await DialogService.ShowAsync<PaymentReviewDialog>(title, parameters);
        var result = await dialog.Result;

        return result is { Canceled: false } && result.Data is string note ? note : null;
    }

    /// <summary>
    /// Pesan respons API dalam bahasa aktif. Bila server tidak mengirim pesan
    /// maupun kunci, dipakai template terlokalisasi dengan nomor pengajuan.
    /// </summary>
    private string ResponseText(BaseGeneralResponse response, string fallbackKey, string requestNo)
    {
        if (!string.IsNullOrWhiteSpace(response.MessageKey) || !string.IsNullOrWhiteSpace(response.Message))
        {
            return L.Message(ApiMessageSource.From(response));
        }

        return L.Format(fallbackKey, requestNo);
    }

    private static string FormatAmount(decimal amount, string currency)
        => $"{currency} {amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("id-ID"))}";

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
