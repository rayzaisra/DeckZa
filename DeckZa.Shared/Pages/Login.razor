@page "/"
@page "/forgot-password"
@page "/reset-password"
@layout MainLayout
@attribute [AllowAnonymous]
@implements IDisposable
@using DeckZa.Application.Common
@inject AuthService AuthService
@inject ITokenStorage TokenStorage
@inject INotifyAuthenticationState AuthStateNotifier
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ThemePreferenceService ThemeService
@inject LanguageService L
@inject MotionService Motion

<MudThemeProvider Theme="ThemeService.LoginTheme" />

@if (IsMauiApp)
{
    <div class="maui-auth-shell neo-brutalism">
        <div class="maui-auth-card">
            <div class="maui-auth-logo">
                <img src="/images/branding/app-logo.png" alt="" />
            </div>

            <div class="maui-auth-heading">
                <h2>@MauiHeaderTitle</h2>
                <p>@MauiHeaderSubtitle</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
            }

            <div class="maui-auth-form-area">
            @if (_requiresPasswordChange)
            {
                <EditForm Model="@_firstLoginModel" OnValidSubmit="@OnFirstLoginPasswordChangeAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_firstLoginModel.CurrentPassword"
                                      Label="@L["CurrentPassword"]"
                                      Placeholder="@L["EnterCurrentPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.NewPassword"
                                      Label="@L["NewPassword"]"
                                      Placeholder="@L["EnterNewPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.ConfirmNewPassword"
                                      Label="@L["ConfirmNewPassword"]"
                                      Placeholder="@L["RepeatNewPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["PasswordMinLength"]
                        </MudText>
                    </div>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>@L["ResetPassword"]</span>
                        }
                    </MudButton>
                </EditForm>
            }
            else if (_mode == LoginMode.Forgot)
            {
                <EditForm Model="@_forgotModel" OnValidSubmit="@OnForgotPasswordAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_forgotModel.UserIdOrEmail"
                                      Label="@L["UsernameOrEmail"]"
                                      Placeholder="@L["EnterUsernameOrEmail"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                    </div>
                    <button type="button" class="login-text-link maui-auth-back" @onclick="ShowSignIn">@L["BackToSignIn"]</button>
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="_forgotLoading">
                        @if (_forgotLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>@L["SendReset"]</span>
                        }
                    </MudButton>
                </EditForm>
            }
            else if (_mode == LoginMode.Reset)
            {
                <div class="maui-auth-fields">
                    <button type="button" class="login-text-link maui-auth-back" @onclick="ShowSignIn">@L["BackToSignIn"]</button>
                    @if (_resetTokenInvalid)
                    {
                        <MudAlert Severity="Severity.Error">@L["ResetTokenInvalidOrExpired"]</MudAlert>
                    }
                    else
                    {
                        <EditForm Model="@_resetModel" OnValidSubmit="@OnResetPasswordAsync">
                            <DataAnnotationsValidator />
                            <MudTextField @bind-Value="_resetModel.NewPassword"
                                          Label="@L["NewPassword"]"
                                          Placeholder="@L["EnterNewPassword"]"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudTextField @bind-Value="_resetModel.ConfirmNewPassword"
                                          Label="@L["ConfirmNewPassword"]"
                                          Placeholder="@L["RepeatNewPassword"]"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["PasswordMinLength"]
                            </MudText>
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Class="maui-auth-submit"
                                       Disabled="_resetLoading">
                                @if (_resetLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>@L["ResetPassword"]</span>
                                }
                            </MudButton>
                        </EditForm>
                    }
                </div>
            }
            else if (_mode == LoginMode.SignUp)
            {
                <EditForm Model="@_signUpModel" OnValidSubmit="@OnSignUpAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_signUpModel.UserId"
                                      Label="@L["UserId"]"
                                      Placeholder="@L["ChooseUserId"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                        <MudTextField @bind-Value="_signUpModel.FullName"
                                      Label="@L["FullName"]"
                                      Placeholder="@L["EnterFullName"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                        <MudTextField @bind-Value="_signUpModel.Email"
                                      Label="@L["Email"]"
                                      Placeholder="@L["EnterEmail"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      InputType="InputType.Email"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />
                        <MudTextField @bind-Value="_signUpModel.Password"
                                      Label="@L["Password"]"
                                      Placeholder="@L["EnterPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_signUpModel.ConfirmPassword"
                                      Label="@L["ConfirmPassword"]"
                                      Placeholder="@L["RepeatPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["PasswordMinLength"]
                        </MudText>
                    </div>
                    @if (_googleEnabled && !IsMauiApp)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Class="google-signin-btn"
                                   Disabled="@(_googleLoading || _signUpLoading)"
                                   OnClick="BeginGoogleSignInAsync">
                            @if (_googleLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>@L["Connecting"]</span>
                            }
                            else
                            {
                                <span class="google-signin-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                                        <path fill="#EA4335" d="M9 7.3636v3.4909h4.8545c-.2127 1.1164-.8509 2.0627-1.8091 2.7018l2.9236 2.2691C16.6727 14.2582 17.6727 11.8909 17.6727 9.2045c0-.6382-.0582-1.2509-.1636-1.8409H9z"/>
                                        <path fill="#34A853" d="M9 18c2.43 0 4.4673-.8055 5.9564-2.1818l-2.9236-2.2691c-.8055.54-1.8364.8664-3.0327.8664-2.3345 0-4.3164-1.5764-5.0255-3.6982H.9564v2.3455C2.4373 16.0164 5.4818 18 9 18z"/>
                                        <path fill="#4A90E2" d="M3.9745 10.7173A5.41 5.41 0 0 1 3.6873 9c0-.5964.1036-1.1745.2873-1.7173V4.9373H.9564A8.9964 8.9964 0 0 0 0 9c0 1.4527.3473 2.8273.9564 4.0627l3.0182-2.3455z"/>
                                        <path fill="#FBBC05" d="M9 3.5782c1.3218 0 2.5091.4545 3.4418 1.3455l2.5818-2.5818C13.4636.8918 11.4264 0 9 0 5.4818 0 2.4373 1.9836.9564 4.9373l3.0182 2.3455C4.6836 5.1545 6.6655 3.5782 9 3.5782z"/>
                                    </svg>
                                </span>
                                <span>@L["SignInWithGoogle"]</span>
                            }
                        </MudButton>
                        <div class="login-or-divider"><span>@L["OrDivider"]</span></div>
                    }
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="@_signUpLoading">
                        @if (_signUpLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>@L["Register"]</span>
                        }
                    </MudButton>
                    <button type="button" class="login-text-link maui-auth-back" @onclick="ShowSignIn">@L["BackToLogin"]</button>
                </EditForm>
            }
            else
            {
                <EditForm Model="@_loginModel" OnValidSubmit="@OnLoginAsync">
                    <DataAnnotationsValidator />
                    <div class="maui-auth-fields">
                        <MudTextField @bind-Value="_loginModel.UserId"
                                      Label="@L["Username"]"
                                      Placeholder="@L["EnterUsername"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                        <MudTextField @bind-Value="_loginModel.Password"
                                      Label="@L["Password"]"
                                      Placeholder="@L["EnterPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <div class="maui-auth-options">
                            <MudCheckBox T="bool" @bind-Value="_loginModel.RememberMe" Color="Color.Primary">@L["RememberThisDevice"]</MudCheckBox>
                            <button type="button" class="login-text-link" @onclick="ShowForgot">@L["ForgotPasswordQuestion"]</button>
                        </div>
                    </div>
                    @if (_googleEnabled && !IsMauiApp)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Class="google-signin-btn"
                                   Disabled="@(_googleLoading || _isLoading)"
                                   OnClick="BeginGoogleSignInAsync">
                            @if (_googleLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>@L["Connecting"]</span>
                            }
                            else
                            {
                                <span class="google-signin-icon" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                                        <path fill="#EA4335" d="M9 7.3636v3.4909h4.8545c-.2127 1.1164-.8509 2.0627-1.8091 2.7018l2.9236 2.2691C16.6727 14.2582 17.6727 11.8909 17.6727 9.2045c0-.6382-.0582-1.2509-.1636-1.8409H9z"/>
                                        <path fill="#34A853" d="M9 18c2.43 0 4.4673-.8055 5.9564-2.1818l-2.9236-2.2691c-.8055.54-1.8364.8664-3.0327.8664-2.3345 0-4.3164-1.5764-5.0255-3.6982H.9564v2.3455C2.4373 16.0164 5.4818 18 9 18z"/>
                                        <path fill="#4A90E2" d="M3.9745 10.7173A5.41 5.41 0 0 1 3.6873 9c0-.5964.1036-1.1745.2873-1.7173V4.9373H.9564A8.9964 8.9964 0 0 0 0 9c0 1.4527.3473 2.8273.9564 4.0627l3.0182-2.3455z"/>
                                        <path fill="#FBBC05" d="M9 3.5782c1.3218 0 2.5091.4545 3.4418 1.3455l2.5818-2.5818C13.4636.8918 11.4264 0 9 0 5.4818 0 2.4373 1.9836.9564 4.9373l3.0182 2.3455C4.6836 5.1545 6.6655 3.5782 9 3.5782z"/>
                                    </svg>
                                </span>
                                <span>@L["SignInWithGoogle"]</span>
                            }
                        </MudButton>
                        <div class="login-or-divider"><span>@L["OrDivider"]</span></div>
                    }
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="maui-auth-submit"
                               Disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                        }
                        else
                        {
                            <span>@L["Login"]</span>
                        }
                    </MudButton>
                    <MudDivider Class="login-divider my-4" />
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               OnClick="ShowSignUp">
                        @L["Register"]
                    </MudButton>
                </EditForm>
            }
            </div>
        </div>
    </div>
}
else
{
<div class="@LoginPageClass login-shell">
    <section class="login-brand-item">
        <MudPaper Elevation="0" Class="login-brand-panel">
            <div class="login-brand-top">
                <div class="login-logo">
                    <img src="/images/branding/app-logo.png" alt="" />
                </div>
                <div>
                    <div class="login-brand-name">@BrandName</div>
                        <div class="login-brand-subtitle">@L["PersonalTaskAndReportManagement"]</div>
                </div>
            </div>

            <div class="login-brand-visual">
                <img src="/images/login/login-illustration.png"
                     alt="@L["EnterpriseWorkspaceIllustration"]"
                     loading="eager" />
            </div>

            <div class="login-brand-copy">
                <h1>@L["BuiltOnBedrock"]</h1>
                <p>@L["TasksSchedulesReports"]</p>
                <div class="login-brand-proof" aria-label="@L["DeckZaCapabilities"]">
                    <span class="login-brand-proof-chip">@L["Task"]</span>
                    <span class="login-brand-proof-chip">@L["CalendarTitle"]</span>
                    <span class="login-brand-proof-chip">@L["ReportTitle"]</span>
                    <span class="login-brand-proof-chip">@L["BillingTitle"]</span>
                </div>
            </div>
        </MudPaper>
    </section>

    <section class="login-form-item">
        <MudPaper Elevation="0" Class="login-form-panel">
            <div class="login-form-header">
                <h2>@HeaderTitle</h2>
                <p>@HeaderSubtitle</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
            }

            @if (_requiresPasswordChange)
            {
                <EditForm Model="@_firstLoginModel" OnValidSubmit="@OnFirstLoginPasswordChangeAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_firstLoginModel.CurrentPassword"
                                      Label="@L["OldPassword"]"
                                      Placeholder="@L["EnterDefaultPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.NewPassword"
                                      Label="@L["NewPassword"]"
                                      Placeholder="@L["EnterNewPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_firstLoginModel.ConfirmNewPassword"
                                      Label="@L["ConfirmNewPassword"]"
                                      Placeholder="@L["RepeatNewPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["PasswordMinLength"]
                        </MudText>
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>@L["ChangePassword"]</span>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" OnClick="CancelFirstLogin">
                            @L["BackToSignIn"]
                        </MudButton>
                    </div>
                </EditForm>
            }
            else if (_mode == LoginMode.Forgot)
            {
                <EditForm Model="@_forgotModel" OnValidSubmit="@OnForgotPasswordAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_forgotModel.UserIdOrEmail"
                                      Label="@L["UsernameOrEmail"]"
                                      Placeholder="@L["EnterUsernameOrEmail"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="_forgotLoading">
                            @if (_forgotLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>@L["ResetInstructionsSent"]</span>
                            }
                        </MudButton>
                        <button type="button" class="login-text-link" @onclick="ShowSignIn">@L["BackToSignIn"]</button>
                    </div>
                </EditForm>
            }
            else if (_mode == LoginMode.Reset)
            {
                <div class="login-form-fields">
                    @if (_resetTokenInvalid)
                    {
                        <MudAlert Severity="Severity.Error">@L["ResetTokenInvalidOrExpired"]</MudAlert>
                    }
                    else
                    {
                        <EditForm Model="@_resetModel" OnValidSubmit="@OnResetPasswordAsync">
                            <DataAnnotationsValidator />
                            <MudTextField @bind-Value="_resetModel.NewPassword"
                                          Label="@L["NewPassword"]"
                                          Placeholder="@L["EnterNewPassword"]"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudTextField @bind-Value="_resetModel.ConfirmNewPassword"
                                          Label="@L["ConfirmNewPassword"]"
                                          Placeholder="@L["RepeatNewPassword"]"
                                          Variant="Variant.Outlined"
                                          FullWidth="true"
                                          InputType="InputType.Password"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Lock" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @L["PasswordMinLength"]
                            </MudText>
                            <MudButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Disabled="_resetLoading">
                                @if (_resetLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                                }
                                else
                                {
                                    <span>@L["ResetPassword"]</span>
                                }
                            </MudButton>
                        </EditForm>
                    }
                    <button type="button" class="login-text-link" @onclick="ShowSignIn">@L["BackToSignIn"]</button>
                </div>
            }
            else if (_mode == LoginMode.SignUp)
            {
                <EditForm Model="@_signUpModel" OnValidSubmit="@OnSignUpAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_signUpModel.UserId"
                                      Label="@L["UserId"]"
                                      Placeholder="@L["ChooseUserId"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                        <MudTextField @bind-Value="_signUpModel.FullName"
                                      Label="@L["FullName"]"
                                      Placeholder="@L["EnterFullName"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Person" />
                        <MudTextField @bind-Value="_signUpModel.Email"
                                      Label="@L["Email"]"
                                      Placeholder="@L["EnterEmail"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      InputType="InputType.Email"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email" />
                        <MudTextField @bind-Value="_signUpModel.Password"
                                      Label="@L["Password"]"
                                      Placeholder="@L["EnterPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudTextField @bind-Value="_signUpModel.ConfirmPassword"
                                      Label="@L["ConfirmPassword"]"
                                      Placeholder="@L["RepeatPassword"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Required="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @L["PasswordMinLength"]
                        </MudText>
                        @if (_googleEnabled)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Class="google-signin-btn"
                                       Disabled="@(_googleLoading || _signUpLoading)"
                                       OnClick="BeginGoogleSignInAsync">
                                @if (_googleLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>@L["Connecting"]</span>
                                }
                                else
                                {
                                    <span class="google-signin-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                                            <path fill="#EA4335" d="M9 7.3636v3.4909h4.8545c-.2127 1.1164-.8509 2.0627-1.8091 2.7018l2.9236 2.2691C16.6727 14.2582 17.6727 11.8909 17.6727 9.2045c0-.6382-.0582-1.2509-.1636-1.8409H9z"/>
                                            <path fill="#34A853" d="M9 18c2.43 0 4.4673-.8055 5.9564-2.1818l-2.9236-2.2691c-.8055.54-1.8364.8664-3.0327.8664-2.3345 0-4.3164-1.5764-5.0255-3.6982H.9564v2.3455C2.4373 16.0164 5.4818 18 9 18z"/>
                                            <path fill="#4A90E2" d="M3.9745 10.7173A5.41 5.41 0 0 1 3.6873 9c0-.5964.1036-1.1745.2873-1.7173V4.9373H.9564A8.9964 8.9964 0 0 0 0 9c0 1.4527.3473 2.8273.9564 4.0627l3.0182-2.3455z"/>
                                            <path fill="#FBBC05" d="M9 3.5782c1.3218 0 2.5091.4545 3.4418 1.3455l2.5818-2.5818C13.4636.8918 11.4264 0 9 0 5.4818 0 2.4373 1.9836.9564 4.9373l3.0182 2.3455C4.6836 5.1545 6.6655 3.5782 9 3.5782z"/>
                                        </svg>
                                    </span>
                                    <span>@L["SignInWithGoogle"]</span>
                                }
                            </MudButton>
                            <div class="login-or-divider"><span>@L["OrDivider"]</span></div>
                        }
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="@_signUpLoading">
                            @if (_signUpLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>@L["Register"]</span>
                            }
                        </MudButton>
                        <button type="button" class="login-text-link" @onclick="ShowSignIn">@L["BackToLogin"]</button>
                    </div>
                </EditForm>
            }
            else
            {
                <EditForm Model="@_loginModel" OnValidSubmit="@OnLoginAsync">
                    <DataAnnotationsValidator />
                    <div class="login-form-fields">
                        <MudTextField @bind-Value="_loginModel.UserId"
                                      Label="@L["Username"]"
                                      Placeholder="@L["EnterUserId"]"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Badge" />
                        <MudTextField @bind-Value="_loginModel.Password"
                                      Label="@L["Password"]"
                                      Placeholder="••••••••"
                                      Variant="Variant.Outlined"
                                      FullWidth="true"
                                      InputType="InputType.Password"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Lock" />
                        <div class="login-form-options">
                            <MudCheckBox T="bool" @bind-Value="_loginModel.RememberMe" Color="Color.Primary">@L["RememberThisDevice"]</MudCheckBox>
                            <button type="button" class="login-text-link" @onclick="ShowForgot">@L["ForgotPasswordQuestion"]</button>
                        </div>
                        @if (_googleEnabled)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       FullWidth="true"
                                       Size="Size.Large"
                                       Class="google-signin-btn"
                                       Disabled="@(_googleLoading || _isLoading)"
                                       OnClick="BeginGoogleSignInAsync">
                                @if (_googleLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>@L["Connecting"]</span>
                                }
                                else
                                {
                                    <span class="google-signin-icon" aria-hidden="true">
                                        <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                                            <path fill="#EA4335" d="M9 7.3636v3.4909h4.8545c-.2127 1.1164-.8509 2.0627-1.8091 2.7018l2.9236 2.2691C16.6727 14.2582 17.6727 11.8909 17.6727 9.2045c0-.6382-.0582-1.2509-.1636-1.8409H9z"/>
                                            <path fill="#34A853" d="M9 18c2.43 0 4.4673-.8055 5.9564-2.1818l-2.9236-2.2691c-.8055.54-1.8364.8664-3.0327.8664-2.3345 0-4.3164-1.5764-5.0255-3.6982H.9564v2.3455C2.4373 16.0164 5.4818 18 9 18z"/>
                                            <path fill="#4A90E2" d="M3.9745 10.7173A5.41 5.41 0 0 1 3.6873 9c0-.5964.1036-1.1745.2873-1.7173V4.9373H.9564A8.9964 8.9964 0 0 0 0 9c0 1.4527.3473 2.8273.9564 4.0627l3.0182-2.3455z"/>
                                            <path fill="#FBBC05" d="M9 3.5782c1.3218 0 2.5091.4545 3.4418 1.3455l2.5818-2.5818C13.4636.8918 11.4264 0 9 0 5.4818 0 2.4373 1.9836.9564 4.9373l3.0182 2.3455C4.6836 5.1545 6.6655 3.5782 9 3.5782z"/>
                                        </svg>
                                    </span>
                                    <span>@L["SignInWithGoogle"]</span>
                                }
                            </MudButton>
                            <div class="login-or-divider"><span>@L["OrDivider"]</span></div>
                        }
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   Disabled="@_isLoading">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Color="Color.Info" Indeterminate="true" />
                            }
                            else
                            {
                                <span>@L["Login"]</span>
                            }
                        </MudButton>
                        <MudDivider Class="login-divider my-4" />
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   OnClick="ShowSignUp">
                            Register
                        </MudButton>
                    </div>
                </EditForm>
            }

        </MudPaper>
    </section>
</div>
}

@code {
    private const string BrandName = "DeckZa";
    private static bool IsMauiApp => !OperatingSystem.IsBrowser();
    private string LoginPageClass => $"login-page {(ThemeService.IsNeoBrutalism ? "neo-brutalism" : "classic-login")} palette-{ThemeService.Palette}";
    private string MauiHeaderTitle => _requiresPasswordChange ? L["ResetPassword"] : HeaderTitle;
    private string MauiHeaderSubtitle => _requiresPasswordChange
        ? L["ChooseNewPassword"]
        : HeaderSubtitle;

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? GoogleCode { get; set; }

    [SupplyParameterFromQuery(Name = "state")]
    public string? GoogleState { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? GoogleError { get; set; }

    [SupplyParameterFromQuery(Name = "error_description")]
    public string? GoogleErrorDescription { get; set; }

    [SupplyParameterFromQuery(Name = "message")]
    public string? ErrorMessageQuery { get; set; }

    private readonly LoginRequestDto _loginModel = new();
    private readonly ForgotPasswordRequestDto _forgotModel = new();
    private readonly ResetPasswordRequestDto _resetModel = new();
    private FirstLoginPasswordDto _firstLoginModel = new();
    private RegisterRequestDto _signUpModel = new();
    private LoginMode _mode = LoginMode.SignIn;
    private bool _isLoading;
    private bool _forgotLoading;
    private bool _resetLoading;
    private bool _signUpLoading;
    private bool _resetTokenInvalid;
    private bool _requiresPasswordChange;
    private bool _googleEnabled;
    private bool _googleLoading;
    private string? _errorMessage;
    private string? _successMessage;

    private enum LoginMode
    {
        SignIn,
        Forgot,
        Reset,
        SignUp,
    }

    private string HeaderTitle => _requiresPasswordChange
        ? L["ChangePassword"]
        : _mode switch
        {
            LoginMode.Forgot => L["ForgotPassword"],
            LoginMode.Reset => L["ResetPassword"],
            LoginMode.SignUp => L["Register"] == "Register" ? "Register" : L["Register"],
            _ => L["SignIn"],
        };

    private string HeaderSubtitle => _requiresPasswordChange
        ? L["FirstLoginPasswordSubtitle"]
        : _mode switch
        {
            LoginMode.Forgot => L["ForgotPasswordSubtitle"],
            LoginMode.Reset => L["ChooseNewPassword"],
            LoginMode.SignUp => L["Register"] == "Register" ? "Create your account" : L["Register"],
            _ => L["EnterCredentialsToContinue"],
        };

    protected override void OnInitialized()
    {
        L.OnChange += HandleLanguageChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();
        await ThemeService.InitializeAsync();

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        if (path.Equals("forgot-password", StringComparison.OrdinalIgnoreCase))
        {
            _mode = LoginMode.Forgot;
            return;
        }

        if (path.Equals("reset-password", StringComparison.OrdinalIgnoreCase))
        {
            _mode = LoginMode.Reset;
            _resetModel.Token = Token ?? string.Empty;
            if (string.IsNullOrWhiteSpace(_resetModel.Token))
            {
                _resetTokenInvalid = true;
                Snackbar.Add(L["ResetTokenMissing"], Severity.Error);
                return;
            }

            try
            {
                _resetTokenInvalid = !await AuthService.ValidatePasswordResetTokenAsync(_resetModel.Token);
            }
            catch (Exception ex)
            {
                _resetTokenInvalid = true;
                if (IsMauiApp)
                {
                    await ShowMauiErrorAsync("MobileValidateResetToken", ex);
                }
                else
                {
                    Snackbar.Add(ex.Message, Severity.Error);
                }
            }

            if (_resetTokenInvalid)
            {
                Snackbar.Add(L["ResetTokenInvalidOrExpired"], Severity.Error);
            }

            return;
        }

        if (path.Equals("signin-google", StringComparison.OrdinalIgnoreCase))
        {
            await HandleGoogleCallbackAsync();
            return;
        }

        await LoadGoogleConfigAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await ThemeService.InitializeAsync();
    }

    private void ShowForgot()
    {
        _mode = LoginMode.Forgot;
        _errorMessage = null;
        _successMessage = null;
        _forgotModel.UserIdOrEmail = _loginModel.UserId;
    }

    private void ShowSignUp()
    {
        _mode = LoginMode.SignUp;
        _errorMessage = null;
        _successMessage = null;
        _signUpModel.UserId = _loginModel.UserId;
    }

    private void ShowSignIn()
    {
        _mode = LoginMode.SignIn;
        _requiresPasswordChange = false;
        _resetTokenInvalid = false;
        _errorMessage = null;
        _successMessage = null;
        _forgotModel.UserIdOrEmail = string.Empty;
        _resetModel.Token = string.Empty;
        _resetModel.NewPassword = string.Empty;
        _resetModel.ConfirmNewPassword = string.Empty;
        _signUpModel = new RegisterRequestDto();

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
        if (path.Equals("forgot-password", StringComparison.OrdinalIgnoreCase)
            || path.Equals("reset-password", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task OnForgotPasswordAsync()
    {
        if (_forgotLoading)
        {
            return;
        }

        _forgotLoading = true;
        try
        {
            await AuthService.RequestPasswordResetAsync(_forgotModel.UserIdOrEmail);
            Snackbar.Add(L["ResetInstructionsQueued"], Severity.Success);
            ShowSignIn();
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileForgotPassword", ex, _forgotModel.UserIdOrEmail);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        finally
        {
            _forgotLoading = false;
        }
    }

    private async Task OnSignUpAsync()
    {
        if (_signUpLoading)
        {
            return;
        }

        var userId = (_signUpModel.UserId ?? string.Empty).Trim();
        var fullName = (_signUpModel.FullName ?? string.Empty).Trim();
        var email = (_signUpModel.Email ?? string.Empty).Trim();

        if (string.IsNullOrWhiteSpace(userId))
        {
            _errorMessage = "User ID is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(fullName))
        {
            _errorMessage = "Full name is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(email))
        {
            _errorMessage = "Email is required.";
            return;
        }

        if (!email.Contains('@', StringComparison.Ordinal))
        {
            _errorMessage = "Email format is not valid.";
            return;
        }

        if (!string.Equals(_signUpModel.Password, _signUpModel.ConfirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = "Password and confirmation do not match.";
            return;
        }

        var policyError = PasswordPolicy.Validate(_signUpModel.Password);
        if (policyError != null)
        {
            _errorMessage = policyError;
            return;
        }

        _signUpLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            await AuthService.RegisterAsync(new RegisterRequestDto
            {
                UserId = userId,
                FullName = fullName,
                Email = email,
                Password = _signUpModel.Password,
                ConfirmPassword = _signUpModel.ConfirmPassword,
            });

            ShowSignIn();
            _successMessage = "Registration successful.";
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileSignUp", ex, userId);
            }
            else
            {
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _signUpLoading = false;
        }
    }

    private async Task OnResetPasswordAsync()
    {
        if (_resetLoading)
        {
            return;
        }

        var policyError = PasswordPolicy.Validate(_resetModel.NewPassword);
        if (policyError != null)
        {
            Snackbar.Add(policyError, Severity.Error);
            return;
        }

        if (!string.Equals(_resetModel.NewPassword, _resetModel.ConfirmNewPassword, StringComparison.Ordinal))
        {
            Snackbar.Add(L["NewPasswordAndConfirmationDoNotMatch"], Severity.Error);
            return;
        }

        _resetLoading = true;
        try
        {
            await AuthService.ResetPasswordAsync(_resetModel);
            Snackbar.Add(L["PasswordResetSuccessSignIn"], Severity.Success);
            ShowSignIn();
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileResetPassword", ex);
            }
            else
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
        finally
        {
            _resetLoading = false;
        }
    }

    private async Task OnLoginAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthService.LoginAsync(_loginModel);
            if (response == null)
            {
                _errorMessage = "Login failed.";
                return;
            }

            if (response.RequiresPasswordChange)
            {
                _requiresPasswordChange = true;
                _successMessage = null;
                _firstLoginModel = new FirstLoginPasswordDto
                {
                    UserId = _loginModel.UserId,
                    CurrentPassword = _loginModel.Password,
                };
                _loginModel.Password = string.Empty;
                return;
            }

            await TokenStorage.SetRememberMeAsync(_loginModel.RememberMe);
            await TokenStorage.SetAccessTokenAsync(response.AccessToken);
            await TokenStorage.SetRefreshTokenAsync(response.RefreshToken);
            AuthStateNotifier.NotifyUserLogin(response.User.UserId);

            if (response.UrlDestination == "changepassword")
            {
                Navigation.NavigateTo("/change-password", true);
            }
            else if (IsMauiApp)
            {
                Navigation.NavigateTo("/maui/dashboard");
            }
            else
            {
                await Motion.BeginRouteTransitionAsync();
                await Task.Delay(180);
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileLogin", ex, _loginModel.UserId);
            }
            else
            {
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnFirstLoginPasswordChangeAsync()
    {
        if (_isLoading)
        {
            return;
        }

        _errorMessage = null;
        _successMessage = null;

        var policyError = PasswordPolicy.Validate(_firstLoginModel.NewPassword);
        if (policyError != null)
        {
            _errorMessage = policyError;
            return;
        }

        if (!string.Equals(_firstLoginModel.NewPassword, _firstLoginModel.ConfirmNewPassword, StringComparison.Ordinal))
        {
            _errorMessage = "New password and confirmation do not match.";
            return;
        }

        _isLoading = true;
        try
        {
            await AuthService.ChangeFirstLoginPasswordAsync(_firstLoginModel);
            _requiresPasswordChange = false;
            _firstLoginModel = new FirstLoginPasswordDto();
            _loginModel.Password = string.Empty;
            _successMessage = "Password changed successfully. Please sign in with your new password.";
        }
        catch (Exception ex)
        {
            if (IsMauiApp)
            {
                await ShowMauiErrorAsync("MobileFirstLogin", ex, _firstLoginModel.UserId);
            }
            else
            {
                _errorMessage = ex.Message;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ShowMauiErrorAsync(string source, Exception exception, string? userId = null)
    {
        _errorMessage = null;
        Snackbar.Add(GetMauiErrorMessage(exception), Severity.Error);
        await AuthService.LogClientErrorAsync(source, exception, userId);
    }

    private static string GetMauiErrorMessage(Exception exception)
    {
        if (exception is HttpRequestException or TaskCanceledException
            || exception.Message.Contains('<')
            || exception.Message.Contains("Bad Request", StringComparison.OrdinalIgnoreCase))
        {
            return "Unable to connect to the server. Please try again later.";
        }

        return string.IsNullOrWhiteSpace(exception.Message)
            ? "Unable to process the request. Please try again later."
            : exception.Message;
    }

    private void CancelFirstLogin()
    {
        _requiresPasswordChange = false;
        _firstLoginModel = new FirstLoginPasswordDto();
        _errorMessage = null;
        _successMessage = null;
    }

    private async Task LoadGoogleConfigAsync()
    {
        if (IsMauiApp)
        {
            _googleEnabled = false;
            return;
        }

        try
        {
            var config = await AuthService.GetGoogleConfigAsync();
            _googleEnabled = config?.Enabled == true && !string.IsNullOrWhiteSpace(config.ClientId);
        }
        catch
        {
            _googleEnabled = false;
        }
    }

    private async Task BeginGoogleSignInAsync()
    {
        if (_googleLoading || !_googleEnabled || IsMauiApp)
        {
            return;
        }

        _googleLoading = true;
        _errorMessage = null;
        _successMessage = null;
        try
        {
            var config = await AuthService.GetGoogleConfigAsync();
            if (config?.Enabled != true || string.IsNullOrWhiteSpace(config.ClientId))
            {
                _googleEnabled = false;
                _errorMessage = "Google sign-in is not available.";
                return;
            }

            var redirectUri = string.IsNullOrWhiteSpace(config.RedirectUri)
                ? Navigation.ToAbsoluteUri("/signin-google").ToString()
                : config.RedirectUri;
            var state = CreateUrlSafeToken(32);
            var codeVerifier = CreateUrlSafeToken(64);
            var codeChallenge = CreateCodeChallenge(codeVerifier);

            await JS.InvokeVoidAsync("sessionStorage.setItem", "deckza_google_state", state);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "deckza_google_verifier", codeVerifier);
            await JS.InvokeVoidAsync("sessionStorage.setItem", "deckza_google_redirect", redirectUri);

            var query = string.Join("&", new Dictionary<string, string>
            {
                ["client_id"] = config.ClientId,
                ["redirect_uri"] = redirectUri,
                ["response_type"] = "code",
                ["scope"] = string.IsNullOrWhiteSpace(config.Scope) ? "openid email profile" : config.Scope,
                ["state"] = state,
                ["code_challenge"] = codeChallenge,
                ["code_challenge_method"] = "S256",
                ["prompt"] = "select_account",
                ["access_type"] = "online",
            }.Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value)}"));

            Navigation.NavigateTo($"https://accounts.google.com/o/oauth2/v2/auth?{query}", forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _googleLoading = false;
        }
    }

    private async Task HandleGoogleCallbackAsync()
    {
        if (IsMauiApp)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _isLoading = true;
        _googleLoading = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var config = await AuthService.GetGoogleConfigAsync();
            _googleEnabled = config?.Enabled == true;

            if (!string.IsNullOrWhiteSpace(GoogleError))
            {
                _errorMessage = GoogleError.Equals("access_denied", StringComparison.OrdinalIgnoreCase)
                    ? "Google sign-in was cancelled."
                    : $"Google sign-in failed: {GoogleError}.";
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            if (string.IsNullOrWhiteSpace(GoogleCode) || string.IsNullOrWhiteSpace(GoogleState))
            {
                Navigation.NavigateTo("/", replace: true);
                return;
            }

            var expectedState = await JS.InvokeAsync<string?>("sessionStorage.getItem", "deckza_google_state");
            var codeVerifier = await JS.InvokeAsync<string?>("sessionStorage.getItem", "deckza_google_verifier");
            var redirectUri = await JS.InvokeAsync<string?>("sessionStorage.getItem", "deckza_google_redirect");

            await JS.InvokeVoidAsync("sessionStorage.removeItem", "deckza_google_state");
            await JS.InvokeVoidAsync("sessionStorage.removeItem", "deckza_google_verifier");
            await JS.InvokeVoidAsync("sessionStorage.removeItem", "deckza_google_redirect");

            if (string.IsNullOrWhiteSpace(expectedState)
                || !string.Equals(expectedState, GoogleState, StringComparison.Ordinal)
                || string.IsNullOrWhiteSpace(codeVerifier)
                || string.IsNullOrWhiteSpace(redirectUri))
            {
                Navigation.NavigateTo("/?message=" + Uri.EscapeDataString("Google sign-in session is invalid or expired. Please try again."), replace: true);
                return;
            }

            var response = await AuthService.SignInWithGoogleAsync(new GoogleSignInRequestDto
            {
                Code = GoogleCode,
                CodeVerifier = codeVerifier,
                RedirectUri = redirectUri,
            });

            if (response == null)
            {
                Navigation.NavigateTo("/?message=" + Uri.EscapeDataString("Unable to sign in with Google. Please try again."), replace: true);
                return;
            }

            await TokenStorage.SetRememberMeAsync(false);
            await TokenStorage.SetAccessTokenAsync(response.AccessToken);
            await TokenStorage.SetRefreshTokenAsync(response.RefreshToken);
            if (!string.IsNullOrWhiteSpace(response.GoogleAccessToken))
            {
                await JS.InvokeVoidAsync("sessionStorage.setItem", "deckza_google_access_token", response.GoogleAccessToken);
                await JS.InvokeVoidAsync("sessionStorage.setItem", "deckza_google_access_token_exp", DateTimeOffset.UtcNow.AddMinutes(55).ToUnixTimeSeconds().ToString());
            }
            AuthStateNotifier.NotifyUserLogin(response.User.UserId);

            var pendingSync = await JS.InvokeAsync<string?>("sessionStorage.getItem", "deckza_google_sync_pending");
            if (string.Equals(pendingSync, "1", StringComparison.Ordinal))
            {
                await JS.InvokeVoidAsync("sessionStorage.removeItem", "deckza_google_sync_pending");
                Navigation.NavigateTo("/profile?google_sync=1", forceLoad: true);
                return;
            }

            await Motion.BeginRouteTransitionAsync();
            await Task.Delay(180);
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            Navigation.NavigateTo("/?message=" + Uri.EscapeDataString(ex.Message), replace: true);
        }
        finally
        {
            _isLoading = false;
            _googleLoading = false;
        }
    }

    private static string CreateUrlSafeToken(int byteLength)
    {
        var bytes = System.Security.Cryptography.RandomNumberGenerator.GetBytes(byteLength);
        return Convert.ToBase64String(bytes)
            .TrimEnd('=')
            .Replace('+', '-')
            .Replace('/', '_');
    }

    private static string CreateCodeChallenge(string codeVerifier)
    {
        var bytes = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.ASCII.GetBytes(codeVerifier));
        return Convert.ToBase64String(bytes)
            .TrimEnd('=')
            .Replace('+', '-')
            .Replace('/', '_');
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
