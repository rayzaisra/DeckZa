@page "/dashboard"
@layout AuthenticatedLayout
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject LanguageService L
@implements IDisposable

<AuthorizeView Roles="99">
    <Authorized>
        <MemberDashboard ShowUpgradeBanner="true" />
    </Authorized>
    <NotAuthorized Context="guestContext">
        <AuthorizeView Roles="01">
            <Authorized>
                <MemberDashboard />
            </Authorized>
            <NotAuthorized Context="memberContext">
                <MudContainer MaxWidth="MaxWidth.False" Class="pa-0 dashboard-page">
                    <MudPaper Elevation="0" Class="dashboard-hero">
                        <div>
                            <div class="dashboard-kicker">@L["PersonalTaskAndReportManagement"]</div>
                            <h1>@L.Format("HelloName", _displayName)</h1>
                            <p>@L["WelcomeBackDashboard"]</p>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.WavingHand" Class="dashboard-hero-icon" />
                    </MudPaper>
                </MudContainer>
            </NotAuthorized>
        </AuthorizeView>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string _displayName = "Administrator";

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var name = authState.User.Identity?.Name;
        if (!string.IsNullOrWhiteSpace(name))
        {
            _displayName = name;
        }
    }

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
