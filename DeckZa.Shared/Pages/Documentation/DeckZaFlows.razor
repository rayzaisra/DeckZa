@page "/dashboard/documentation/deckza-flows"
@layout AuthenticatedLayout
@attribute [Authorize]
@using MudBlazor
@using DeckZa.Shared.Pages.Documentation

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">Documentation</div>
        <h1>DeckZa Flows</h1>
        <p>How to use DeckZa day to day: master data, tasks, calendar, report, and the Guest plan limits.</p>
    </div>
</div>

<MudPaper Elevation="0" Class="dashboard-card mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">Start here</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        This page is readable by every signed-in user. It explains the DeckZa application itself.
        For the underlying framework — users, groups, roles, menus, parameters, and approvals — see
        <strong>Framework Flows</strong>, which is available to administrators only.
    </MudText>

    <div class="d-flex flex-wrap gap-2">
        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Set up master data first</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">Each account owns its own data</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">Completed status drives the report</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">Guest plan has limits</MudChip>
    </div>

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.subtitle2" Class="mb-2">Recommended order</MudText>
    <div class="d-flex flex-wrap align-center gap-2">
        @for (var i = 0; i < FlowOrder.Length; i++)
        {
            var label = FlowOrder[i];
            <MudChip T="string" Size="Size.Small" Color="Color.Default">@label</MudChip>
            @if (i < FlowOrder.Length - 1)
            {
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Default" />
            }
        }
    </div>
</MudPaper>

<MudPaper Elevation="0" Class="dashboard-card mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">Plan comparison</MudText>
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr>
                <th>Capability</th>
                <th>Guest</th>
                <th>Member</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in PlanComparison)
            {
                <tr>
                    <td>@row.Capability</td>
                    <td>@row.Guest</td>
                    <td>@row.Member</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    <MudAlert Severity="Severity.Info" Class="mt-3">
        Limits are read from the plan data, not hardcoded. An administrator can adjust them in
        Parameter Engine without a code change.
    </MudAlert>
</MudPaper>

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">
    @foreach (var flow in DeckZaFlowCatalog.Flows)
    {
        <MudTabPanel Text="@flow.Tab" Icon="@flow.Icon">
            <MudText Typo="Typo.h5" Class="mb-2">@flow.Title</MudText>
            <MudText Typo="Typo.body1" Class="mb-3">@flow.Summary</MudText>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <MudChip T="string" Size="Size.Small" Color="Color.Default">@flow.Audience</MudChip>
                <MudChip T="string" Size="Size.Small"
                         Color="@(flow.Approval == "No approval" ? Color.Success : Color.Warning)">
                    @flow.Approval
                </MudChip>
            </div>

            <MudGrid Spacing="3">
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">Before you start</MudText>
                        @foreach (var prerequisite in flow.Prerequisites)
                        {
                            <div class="d-flex gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                         Color="Color.Primary"
                                         Size="Size.Small" />
                                <MudText Typo="Typo.body2">@prerequisite</MudText>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">Steps</MudText>
                        @for (var i = 0; i < flow.Steps.Count; i++)
                        {
                            var step = flow.Steps[i];
                            var stepNumber = i + 1;
                            <div class="d-flex gap-3 mb-3">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@stepNumber</MudChip>
                                <div>
                                    <MudText Typo="Typo.subtitle2">@step.Title</MudText>
                                    <MudText Typo="Typo.body2">@step.Detail</MudText>
                                </div>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Watch out</MudText>
                    @foreach (var warning in flow.Warnings)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2">@warning</MudAlert>
                    }
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Technical reference</MudText>
                    <MudPaper Outlined="true" Class="pa-4">
                        @foreach (var line in flow.Technical)
                        {
                            <MudText Typo="Typo.body2" Class="mb-1">
                                <code>@line</code>
                            </MudText>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    }
</MudTabs>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Dashboard", href: "/dashboard"),
        new BreadcrumbItem("Documentation", href: null, disabled: true),
        new BreadcrumbItem("DeckZa Flows", href: null, disabled: true),
    };

    private static readonly string[] FlowOrder =
    {
        "My Master Data",
        "Task Management",
        "Calendar",
        "Report",
    };

    private static readonly PlanRow[] PlanComparison =
    {
        new("Active tasks", "50", "Unlimited"),
        new("Excel import", "Not available", "Available"),
        new("Report period", "Current month", "Any period"),
        new("Calendar", "Not available", "Available"),
        new("Master rows per table", "3", "Unlimited"),
    };

    private sealed record PlanRow(string Capability, string Guest, string Member);
}
