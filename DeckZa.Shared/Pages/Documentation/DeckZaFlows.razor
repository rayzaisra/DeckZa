@page "/dashboard/documentation/deckza-flows"
@layout AuthenticatedLayout
@attribute [Authorize]
@implements IDisposable
@using MudBlazor
@using DeckZa.Shared.Pages.Documentation
@inject LanguageService L

<MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="mb-3" />

<div class="page-heading">
    <div>
        <div class="dashboard-kicker">@L["Documentation"]</div>
        <h1>@L["DeckZaFlowsTitle"]</h1>
        <p>@L["DeckZaFlowsSubtitle"]</p>
    </div>
</div>

<MudPaper Elevation="0" Class="dashboard-card mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@L["StartHere"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        @L["DeckZaFlowsIntro"]
        <strong>@L["FrameworkFlowsTitle"]</strong>.
    </MudText>

    <div class="d-flex flex-wrap gap-2">
        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@L["SetUpTaskParametersFirst"]</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["EachAccountOwnsItsData"]</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["CompletedStatusDrivesReport"]</MudChip>
        <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["GuestPlanHasLimits"]</MudChip>
    </div>

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.subtitle2" Class="mb-2">@L["RecommendedOrder"]</MudText>
    <div class="d-flex flex-wrap align-center gap-2">
        @for (var i = 0; i < FlowOrder.Length; i++)
        {
            var label = FlowOrder[i];
            <MudChip T="string" Size="Size.Small" Color="Color.Default">@label</MudChip>
            @if (i < FlowOrder.Length - 1)
            {
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Default" />
            }
        }
    </div>
</MudPaper>

<MudPaper Elevation="0" Class="dashboard-card mb-4">
    <MudText Typo="Typo.h6" Class="mb-2">@L["PlanComparison"]</MudText>
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr>
                <th>@L["Capability"]</th>
                <th>@L["Guest"]</th>
                <th>@L["Member"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in PlanComparison)
            {
                <tr>
                    <td>@row.Capability</td>
                    <td>@row.Guest</td>
                    <td>@row.Member</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
    <MudAlert Severity="Severity.Info" Class="mt-3">
        @L["LimitsFromPlanData"]
    </MudAlert>
</MudPaper>

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">
    @foreach (var flow in DeckZaFlowCatalog.GetFlows(L))
    {
        <MudTabPanel Text="@flow.Tab" Icon="@flow.Icon">
            <MudText Typo="Typo.h5" Class="mb-2">@flow.Title</MudText>
            <MudText Typo="Typo.body1" Class="mb-3">@flow.Summary</MudText>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <MudChip T="string" Size="Size.Small" Color="Color.Default">@flow.Audience</MudChip>
                <MudChip T="string" Size="Size.Small"
                         Color="@(flow.Approval == L["NoApproval"] ? Color.Success : Color.Warning)">
                    @flow.Approval
                </MudChip>
            </div>

            <MudGrid Spacing="3">
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">@L["BeforeYouStart"]</MudText>
                        @foreach (var prerequisite in flow.Prerequisites)
                        {
                            <div class="d-flex gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                         Color="Color.Primary"
                                         Size="Size.Small" />
                                <MudText Typo="Typo.body2">@prerequisite</MudText>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudPaper Outlined="true" Class="pa-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">@L["Steps"]</MudText>
                        @for (var i = 0; i < flow.Steps.Count; i++)
                        {
                            var step = flow.Steps[i];
                            var stepNumber = i + 1;
                            <div class="d-flex gap-3 mb-3">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@stepNumber</MudChip>
                                <div>
                                    <MudText Typo="Typo.subtitle2">@step.Title</MudText>
                                    <MudText Typo="Typo.body2">@step.Detail</MudText>
                                </div>
                            </div>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["WatchOut"]</MudText>
                    @foreach (var warning in flow.Warnings)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2">@warning</MudAlert>
                    }
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["TechnicalReference"]</MudText>
                    <MudPaper Outlined="true" Class="pa-4">
                        @foreach (var line in flow.Technical)
                        {
                            <MudText Typo="Typo.body2" Class="mb-1">
                                <code>@line</code>
                            </MudText>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    }
</MudTabs>

@code {
    private List<BreadcrumbItem> _breadcrumbs => new()
    {
        new BreadcrumbItem(L["Dashboard"], href: "/dashboard"),
        new BreadcrumbItem(L["Documentation"], href: null, disabled: true),
        new BreadcrumbItem(L["DeckZaFlowsTitle"], href: null, disabled: true),
    };

    private string[] FlowOrder => new[]
    {
        L["DzTaskParameterTitle"],
        L["DzTaskManagementTitle"],
        L["DzCalendarTitle"],
        L["DzReportTitle"],
    };

    private PlanRow[] PlanComparison => new PlanRow[]
    {
        new(L["CapActiveTasks"], "50", L["ValueUnlimited"]),
        new(L["CapExcelImport"], L["ValueNotAvailable"], L["ValueAvailable"]),
        new(L["CapReportPeriod"], L["ValueCurrentMonth"], L["ValueAnyPeriod"]),
        new(L["CapCalendar"], L["ValueNotAvailable"], L["ValueAvailable"]),
        new(L["CapMasterRows"], "3", L["ValueUnlimited"]),
    };

    private sealed record PlanRow(string Capability, string Guest, string Member);

    protected override void OnInitialized() => L.OnChange += HandleLanguageChanged;

    private void HandleLanguageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => L.OnChange -= HandleLanguageChanged;
}
