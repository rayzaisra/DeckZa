FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish "DeckZa.Web/DeckZa.Web.csproj" -c Release -o /app/publish
RUN sed -i 's#<base href="/" />#<base href="/deckza/" />#g' /app/publish/wwwroot/index.html
RUN sed -i 's#https://localhost:7143#http://172.16.70.252:8101#g' /app/publish/wwwroot/appsettings.json

FROM nginx:alpine
COPY --from=build /app/publish/wwwroot /usr/share/nginx/html/deckza
COPY docker/nginx.deckza.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
